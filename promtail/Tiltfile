# Promtail Tilt Extension
# Provides Promtail log collector that ships logs to Loki.
#
# Exports:
#   cc_export(cc)            - Returns plugin struct for compose_composer
#   cc_wire_when(cc)        - Auto-wire to Loki when loaded together
#   register_config(cc, ...) - Mount a custom promtail config file

def _detect_container_runtime():
    """Detect if running Docker or Podman and return appropriate volume mounts."""
    # Check if docker command is actually podman
    result = str(local('docker --version 2>/dev/null || echo "unknown"', quiet=True))

    if 'podman' in result.lower():
        # Podman: Use podman socket
        # Note: Podman stores logs differently, we just provide socket access
        return [
            '/run/podman/podman.sock:/var/run/docker.sock',
        ]
    else:
        # Docker: Use standard Docker paths
        return [
            '/var/lib/docker/containers:/var/lib/docker/containers:ro',
            '/var/run/docker.sock:/var/run/docker.sock',
        ]

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    volumes = _detect_container_runtime()

    return cc.create(
        'promtail',
        os.path.dirname(__file__) + '/promtail.yaml',
        labels=['observability'],
        compose_overrides={
            'services': {
                'promtail': {
                    'volumes': volumes,
                },
            },
        },
    )

def register_config(cc, config_path):
    """
    Mount a custom promtail configuration file.

    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)
        config_path: Absolute path to the promtail config YAML file

    Returns:
        Dict with compose_overrides to mount the config at /etc/promtail/config.yml

    Example:
        promtail.register_config(repo_root + '/config/promtail-config.yaml')
    """
    if not config_path:
        fail("config_path cannot be empty")

    return {
        'services': {
            'promtail': {
                'volumes': [
                    config_path + ':/etc/promtail/config.yml',
                ],
            },
        },
    }

def cc_wire_when(cc):
    """
    Declarative wiring for promtail integration.
    Automatically configure promtail to depend on loki when both are loaded.
    """
    return {
        'loki': {
            'services': {
                'promtail': {
                    'depends_on': ['loki'],
                },
            },
        },
    }
