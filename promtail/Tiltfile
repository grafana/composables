# Promtail Tilt Extension
# Provides Promtail log collector that ships logs to Loki.
#
# Exports:
#   cc_export()    - Returns plugin struct for compose_composer
#   get_wire_when()    - Auto-wire to Loki when loaded together

load('ext://compose_composer', 'cc_init')

cc = cc_init('promtail')

def detect_container_runtime():
    """Detect if running Docker or Podman and return appropriate volume mounts."""
    # Check if docker command is actually podman
    result = str(local('docker --version 2>/dev/null || echo "unknown"', quiet=True))

    if 'podman' in result.lower():
        # Podman: Use podman socket
        # Note: Podman stores logs differently, we just provide socket access
        return [
            '/run/podman/podman.sock:/var/run/docker.sock',
        ]
    else:
        # Docker: Use standard Docker paths
        return [
            '/var/lib/docker/containers:/var/lib/docker/containers:ro',
            '/var/run/docker.sock:/var/run/docker.sock',
        ]

def cc_export():
    """Returns the plugin struct for compose_composer."""
    volumes = detect_container_runtime()

    return cc.create(
        'promtail',
        os.path.dirname(__file__) + '/promtail.yaml',
        labels=['observability'],
        compose_overrides={
            'services': {
                'promtail': {
                    'volumes': volumes,
                },
            },
        },
    )

def get_wire_when():
    """
    Declarative wiring for promtail integration.
    Automatically configure promtail to depend on loki when both are loaded.
    """
    return {
        'loki': {
            'services': {
                'promtail': {
                    'depends_on': ['loki'],
                },
            },
        },
    }
