# Promtail Tilt Extension
# Provides Promtail log collector that ships logs to Loki.
#
# Exports:
#   cc_get_plugin()    - Returns plugin struct for compose_composer
#   get_wire_when()    - Auto-wire to Loki when loaded together

# Set up extension repo for standalone mode only
if __file__ == config.main_path:
    v1alpha1.extension_repo(name='grafana-tilt-extensions', url='https://github.com/grafana/tilt-extensions', ref='compose-composer')
    v1alpha1.extension(name='compose_composer', repo_name='grafana-tilt-extensions', repo_path='compose_composer')

load('ext://compose_composer', 'cc_local_composable')

def cc_get_plugin():
    """Returns the plugin struct for compose_composer."""
    return cc_local_composable(
        'promtail',
        os.path.dirname(__file__) + '/promtail.yaml',
        labels=['observability'],
    )

def get_wire_when():
    """
    Declarative wiring for promtail integration.
    Automatically configure promtail to depend on loki when both are loaded.
    """
    return {
        'loki': {
            'services': {
                'promtail': {
                    'depends_on': ['loki'],
                },
            },
        },
    }

# ============================================================================
# Standalone Mode
# ============================================================================

# If loaded directly via 'tilt up', run the compose file
if __file__ == config.main_path:
    docker_compose(os.path.dirname(__file__) + '/promtail.yaml')
