# RabbitMQ Tilt Extension
# Provides RabbitMQ message queue with management UI for development.
#
# Exports:
#   cc_get_plugin()    - Returns plugin struct for compose_composer

load('ext://compose_composer', 'cc_local_composable', 'cc_generate_master_compose', 'cc_docker_compose', 'cc_parse_cli_plugins')

def cc_get_plugin():
    """Returns the plugin struct for compose_composer."""
    return cc_local_composable(
        'rabbitmq',
        os.path.dirname(__file__) + '/rabbitmq.yaml',
        labels=['infra'],
    )

