# Redis Tilt Extension
# Provides Redis cache for development.
#
# Exports:
#   cc_export(cc)  - Returns plugin struct for compose_composer

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'redis',
        os.path.dirname(__file__) + '/redis.yaml',
        labels=['infra'],
    )

