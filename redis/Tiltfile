# Redis Tilt Extension
# Provides Redis cache for development.
#
# Exports:
#   cc_export()    - Returns plugin struct for compose_composer

load('ext://compose_composer', 'cc_init')

cc = cc_init('redis')

def cc_export():
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'redis',
        os.path.dirname(__file__) + '/redis.yaml',
        labels=['infra'],
    )

