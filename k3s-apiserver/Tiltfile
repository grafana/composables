# K3s API Server Tilt Extension
# Provides a standalone k3s API server for development.
#
# Exports:
#   get_compose_path()    - Returns path to the compose file
#   get_kubeconfig_path() - Returns path to the kubeconfig output
#   get_provides()        - What this extension provides (for documentation)
#   register_crds()       - Generate compose_overrides to mount CRDs into crd-loader

def get_compose_path(file='k3s-apiserver-generic.yaml'):
    """Returns the absolute path to the compose file for this component."""
    return os.path.dirname(__file__) + '/' + file

def compose_file_contents(file='k3s-apiserver-generic.yaml'):
    """Returns the parsed YAML contents of the compose file."""
    return read_yaml(get_compose_path(file))

def get_kubeconfig_path():
    """Returns the absolute path to the kubeconfig file generated by k3s-apiserver."""
    return os.path.dirname(__file__) + '/output/kubeconfig.yaml'

# ============================================================================
# CRD Registration Helper
# ============================================================================

def register_crds(crd_paths, caller_dir):
    """
    Generate compose_overrides to mount CRDs into the crd-loader service.
    
    This helper keeps CRD-mounting logic encapsulated in k3s-apiserver.
    Callers provide their CRD paths, and this returns the appropriate
    compose_overrides to merge into their k3s-apiserver dependency.
    
    Args:
        crd_paths: List of paths to CRD directories/files, relative to caller_dir
        caller_dir: Absolute path to the caller's directory (os.path.dirname(__file__))
    
    Returns:
        Dict suitable for use as compose_overrides on k3s-apiserver dependency
    
    Example:
        from k3s-apiserver import register_crds
        
        core_dependencies = [
            {
                'name': 'k3s-apiserver',
                'url': '...',
                'compose_overrides': register_crds(
                    crd_paths=['./definitions', './crds'],
                    caller_dir=os.path.dirname(__file__),
                ),
            },
        ]
    """
    volumes = []
    
    for path in crd_paths:
        # Resolve path relative to caller's directory
        if path.startswith('/'):
            abs_path = path
        else:
            abs_path = os.path.abspath(caller_dir + '/' + path)
        
        # Use basename for the mount point under /crds
        mount_name = os.path.basename(abs_path)
        volume_mount = abs_path + ':/crds/' + mount_name + ':ro'
        volumes.append(volume_mount)
    
    if not volumes:
        return {}
    
    return {
        'services': {
            'crd-loader': {
                'volumes': volumes,
            },
        },
    }

def get_provides():
    """
    Declare what this extension provides.
    Used for documentation and discoverability.
    """
    return {
        'services': [
            {
                'name': 'k3s-apiserver',
                'description': 'Kubernetes API server (k3s)',
                'ports': {'6443': 'Kubernetes API'},
            },
            {
                'name': 'cert-provider',
                'description': 'Certificate generation (one-shot)',
            },
            {
                'name': 'traefik',
                'description': 'Webhook proxy for K8s admission controllers',
                'ports': {'443': 'HTTPS webhooks', '8080': 'Dashboard'},
            },
            {
                'name': 'crd-loader',
                'description': 'Generic CRD loader - use register_crds() to mount CRDs',
            },
        ],
        'volumes': [
            {
                'name': 'k3s-certs',
                'description': 'Shared certificates for TLS and API aggregation',
                'paths': {
                    '/api-server-aggregation/': 'Client certs for API aggregation',
                    '/tls/': 'TLS certs for webhooks',
                },
            },
            {
                'name': 'k3s-data',
                'description': 'K3s persistent data (etcd)',
            },
            {
                'name': 'k3s-output',
                'description': 'Kubeconfig and outputs from k3s',
            },
        ],
        'outputs': {
            'kubeconfig': {
                'path': get_kubeconfig_path(),
                'description': 'Kubeconfig for accessing the K3s API server',
            },
        },
    }

# ============================================================================
# Standalone Mode
# ============================================================================

# If loaded directly via 'tilt up', run the compose file
if __file__ == config.main_path:
    docker_compose(get_compose_path())
