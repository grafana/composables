# K3s API Server Tilt Extension
# Provides a standalone k3s API server for development.
#
# Exports:
#   cc_export(cc)                - Returns plugin struct for compose_composer
#   cc_wire_when(cc)            - Conditional wiring rules for Grafana integration
#   get_kubeconfig_path(cc)      - Returns path to the kubeconfig output
#   register_crds(cc, ...)       - Generate compose_overrides to mount CRDs into crd-loader
#   register_webhook(cc, ...)    - Generate compose_overrides to configure webhook operators
#   register_admission_config(cc, ...)  - Generate compose_overrides to register admission webhooks
#   register_roles(cc, ...)      - Generate compose_overrides to apply RBAC roles and bindings
#   create_namespace(cc, ...)    - Generate compose_overrides to create Kubernetes namespaces
#   copy_kubeconfig_local(cc, ...) - Create local_resource to copy kubeconfig to local path
#   enable_in_cluster_config(cc, ...) - Inject KUBERNETES_SERVICE_HOST/PORT for services

def cc_export(cc):
    """Returns the plugin struct for compose_composer.

    This function is only called when loaded as an extension via cc_import().
    cc_create is injected by compose_composer's load_dynamic before this is called.
    """
    return cc.create(
        'k3s-apiserver',
        os.path.dirname(__file__) + '/k3s-apiserver-generic.yaml',
        labels=['k8s'],
    )

def get_kubeconfig_path(cc):
    """Returns the absolute path to the kubeconfig file generated by k3s-apiserver."""
    return os.path.dirname(__file__) + '/output/kubeconfig.yaml'

def register_crds(cc, crd_paths):
    """
    Generate compose_overrides to mount CRDs into the crd-loader service.
    This helper keeps CRD-mounting logic encapsulated in k3s-apiserver.
    Callers provide their CRD paths (absolute), and this returns the appropriate
    modification to apply to k3s-apiserver.
    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)
        crd_paths: List of absolute paths to CRD directories/files.
                   Use os.path.dirname(__file__) + '/crds' for paths relative to your Tiltfile.
    Returns:
        Dict with compose_overrides structure. When used with dependency() helpers,
        the _target field is added automatically by the wrapper.
    Example:
        k3s = dependency(
            name='k3s-apiserver',
            url='...',
        )
        crd_mod = k3s.register_crds(crd_paths=[
            os.path.dirname(__file__) + '/definitions',
            os.path.dirname(__file__) + '/crds',
        ])
        master = generate_master_compose([k3s, mysql], modifications=[crd_mod])
    """
    volumes = []
    for path in crd_paths:
        # Use hash of full path to ensure unique mount points
        # Multiple plugins may have directories with the same basename (e.g., 'definitions')
        # The crd-loader does a recursive find, so the actual mount point name doesn't matter
        path_hash = str(abs(hash(path)))
        volume_mount = path + ':/crds/' + path_hash + ':ro'
        volumes.append(volume_mount)
    if not volumes:
        return {}
    return {
        'services': {
            'crd-loader': {
                'volumes': volumes,
            },
        },
    }

def register_webhook(cc, operator_specs):
    """
    Generate compose_overrides to configure webhook operator routing in Traefik.
    This helper encapsulates webhook operator configuration, eliminating the need
    for hardcoded Traefik labels in plugin docker-compose files.
    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)
        operator_specs: List of dicts, each with:
            - name: str         - Service name of the webhook operator (required)
            - namespace: str    - Kubernetes namespace (default: 'default')
            - port: int         - Container port for HTTPS (default: 8443)
    Returns:
        Dict with compose_overrides structure. The _target field is added
        automatically by the wrapper when this function is imported.
    Example:
        k3s = cc_import(
            name='k3s-apiserver',
            url='...',
        )
        def cc_export():
            return cc_create(
                'my-operator',
                os.path.dirname(__file__) + '/docker-compose.yaml',
                k3s,
                modifications=[
                    k3s.register_webhook(operator_specs=[
                        {
                            'name': 'grafana-servicemodel-operator',
                            'namespace': 'default',
                            'port': 8443,
                        },
                    ]),
                ],
            )
    """
    if not operator_specs:
        return {}

    # Validate operator specs
    if type(operator_specs) != 'list':
        fail("operator_specs must be a list, got: " + str(type(operator_specs)))

    # Build WEBHOOK_OPERATORS string from specs
    operators = []
    for spec in operator_specs:
        if type(spec) != 'dict':
            fail("Each operator spec must be a dict, got: " + str(type(spec)))

        if 'name' not in spec:
            fail("Operator spec must have 'name' field")

        name = spec['name']
        namespace = spec.get('namespace', 'default')
        # port is for documentation/future use - current implementation uses service discovery

        operators.append(name + ':' + namespace)

    webhook_operators_str = ','.join(operators)

    # Build network aliases for Traefik to respond to k8s service DNS names
    # Add all DNS variations that k8s might use to resolve services
    network_aliases = []
    for spec in operator_specs:
        name = spec['name']
        namespace = spec.get('namespace', 'default')
        # Add all k8s service DNS variations as network aliases
        network_aliases.append(name + '.' + namespace + '.svc.cluster.local')
        network_aliases.append(name + '.' + namespace + '.svc')
        network_aliases.append(name + '.' + namespace)
        network_aliases.append(name)  # Short name within same namespace

    # Return compose_overrides that set WEBHOOK_OPERATORS environment variable
    # and configure Traefik network aliases for k8s service DNS resolution.
    # When admission webhooks use the 'url' field (not 'service'), Kubernetes
    # makes direct HTTPS requests via DNS, which resolves to Traefik via these aliases.
    return {
        'services': {
            'cert-provider': {
                'environment': {
                    'WEBHOOK_OPERATORS': webhook_operators_str,
                },
            },
            'traefik': {
                'environment': {
                    'WEBHOOK_OPERATORS': webhook_operators_str,
                },
                'networks': {
                    'default': {
                        'aliases': network_aliases,
                    },
                },
            },
        },
    }

def register_admission_config(cc, admission_yaml_path, resource_name_suffix=''):
    """
    Register admission webhook configuration with the k3s API server.

    This helper creates an admission-setup service that:
    1. Waits for kubeconfig, TLS certificates, and CRDs to be ready
    2. Extracts caBundle from TLS certificate (base64-encoded)
    3. Patches the admission config template with the actual caBundle
    4. Applies the patched config to register admission webhooks

    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)
        admission_yaml_path: str - Path to admission webhook config template
                                   Must contain 'caBundle: .*' placeholder
        resource_name_suffix: str - Optional suffix for service name (default: '')
                                   Use when multiple orchestrators need admission setup
                                   Example: 'servicemodel' creates 'admission-setup-servicemodel'

    Returns:
        Dict with compose_overrides to create admission-setup service with mounted config

    Example:
        k3s = cc_import(
            name='k3s-apiserver',
            url='...',
        )

        def cc_export():
            return cc_create(
                'my-app',
                os.path.dirname(__file__) + '/docker-compose.yaml',
                k3s,
                modifications=[
                    k3s.register_admission_config(
                        admission_yaml_path=os.path.dirname(__file__) + '/local/admission.yaml',
                        resource_name_suffix='myapp'  # Creates 'admission-setup-myapp'
                    ),
                ],
            )

    Admission YAML template format:
        apiVersion: admissionregistration.k8s.io/v1
        kind: MutatingWebhookConfiguration
        metadata:
          name: my-operator-mut-webhook
        webhooks:
        - name: mutate.myapp.com
          clientConfig:
            service:
              name: my-operator
              namespace: default
              path: /mutate
            caBundle: PLACEHOLDER  # <-- Will be replaced with actual certificate
          rules:
          - operations: ["CREATE", "UPDATE"]
            apiGroups: ["myapp.example.com"]
            apiVersions: ["v1alpha1"]
            resources: ["myresources"]
    """
    if type(admission_yaml_path) != 'string':
        fail("admission_yaml_path must be a string, got: " + str(type(admission_yaml_path)))

    if not admission_yaml_path:
        fail("admission_yaml_path cannot be empty")

    # Determine service name
    if resource_name_suffix:
        service_name = 'admission-setup-' + resource_name_suffix
    else:
        service_name = 'admission-setup'

    # Return compose_overrides to add admission-setup service with mounted config
    return {
        'services': {
            service_name: {
                'image': 'bitnami/kubectl:latest',
                'depends_on': ['crd-loader'],
                'volumes': [
                    'k3s-output:/output:ro',
                    'k3s-certs:/certs:ro',
                    admission_yaml_path + ':/admission/config.yaml:ro',
                ],
                'entrypoint': ['/bin/sh'],
                'command': [
                    '-c',
                    '''
echo 'Admission setup starting...'

echo 'Waiting for kubeconfig to be available...'
while [ ! -f /output/kubeconfig.yaml ]; do
  echo 'Kubeconfig not yet available, waiting...'
  sleep 2
done
echo 'Creating modified kubeconfig for container networking...'
sed 's/127\\.0\\.0\\.1:6443/k3s-apiserver:6443/g' /output/kubeconfig.yaml > /tmp/kubeconfig-internal.yaml

echo 'Waiting for TLS certificate to be available...'
while [ ! -f /certs/tls/tls.crt ]; do
  echo 'TLS certificate not yet available, waiting...'
  sleep 2
done

echo 'Generating caBundle from current TLS certificate...'
CA_BUNDLE=$$(cat /certs/tls/tls.crt | base64 | tr -d '\\n')
echo "CA Bundle generated (length: $$(echo $$CA_BUNDLE | wc -c) chars)"

echo 'Patching admission config with current caBundle...'
sed "s|caBundle: .*|caBundle: $$CA_BUNDLE|g" /admission/config.yaml > /tmp/admission-patched.yaml

echo 'Loading admission webhook configuration...'
kubectl --kubeconfig=/tmp/kubeconfig-internal.yaml apply -f /tmp/admission-patched.yaml
echo 'Admission webhook configuration loaded successfully'
                    ''',
                ],
                'restart': 'no',
            },
        },
    }

def register_roles(cc, roles_yaml_path, resource_name_suffix='roles'):
    """
    Register RBAC roles and bindings from a YAML file.

    This helper creates a roles-setup service that applies the RBAC configuration
    to the k3s cluster using kubectl apply.

    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)
        roles_yaml_path: Absolute path to the YAML file containing ClusterRoles,
                        ClusterRoleBindings, Roles, and RoleBindings
        resource_name_suffix: Suffix for the service name (default: 'roles')
                             Creates service: 'roles-setup-{suffix}'

    Returns:
        Dict with compose_overrides structure for the roles-setup service

    Example:
        k3s = cc_import(
            name='k3s-apiserver',
            url='...',
        )

        def cc_export():
            return cc_create(
                'my-app',
                os.path.dirname(__file__) + '/docker-compose.yaml',
                k3s,
                modifications=[
                    k3s.register_roles(
                        roles_yaml_path=os.path.dirname(__file__) + '/local/roles.yaml',
                        resource_name_suffix='labels'  # Creates 'roles-setup-labels'
                    ),
                ],
            )
    """
    if type(roles_yaml_path) != 'string':
        fail("roles_yaml_path must be a string, got: " + str(type(roles_yaml_path)))

    if not roles_yaml_path:
        fail("roles_yaml_path cannot be empty")

    if not roles_yaml_path.startswith('/'):
        fail("roles_yaml_path must be an absolute path, got: " + roles_yaml_path)

    # Determine service name
    service_name = 'roles-setup-' + resource_name_suffix

    # Return compose_overrides to add roles-setup service with mounted config
    return {
        'services': {
            service_name: {
                'image': 'bitnami/kubectl:latest',
                'depends_on': ['crd-loader'],
                'volumes': [
                    'k3s-output:/output:ro',
                    'k3s-certs:/certs:ro',
                    roles_yaml_path + ':/rbac/roles.yaml:ro',
                ],
                'entrypoint': ['/bin/sh'],
                'command': [
                    '-c',
                    '''
echo 'RBAC setup starting...'

echo 'Waiting for kubeconfig to be available...'
while [ ! -f /output/kubeconfig.yaml ]; do
  echo 'Kubeconfig not yet available, waiting...'
  sleep 2
done

echo 'Creating modified kubeconfig for container networking...'
sed 's/127\\.0\\.0\\.1:6443/k3s-apiserver:6443/g' /output/kubeconfig.yaml > /tmp/kubeconfig-internal.yaml

echo 'Loading RBAC roles and bindings...'
kubectl --kubeconfig=/tmp/kubeconfig-internal.yaml apply -f /rbac/roles.yaml
echo 'RBAC configuration loaded successfully'
                    ''',
                ],
                'restart': 'no',
            },
        },
    }

def create_namespace(cc, namespace_specs):
    """
    Create Kubernetes namespaces in k3s-apiserver.

    This helper creates a namespace-setup service that applies namespace
    manifests to the k3s cluster.

    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)
        namespace_specs: List of dicts, each with:
            - name: str         - Namespace name (required)
            - labels: dict      - Optional labels to apply

    Returns:
        Dict with compose_overrides structure

    Example:
        k3s = cc_import(
            name='k3s-apiserver',
            url='...',
        )

        def cc_export():
            return cc_create(
                'my-app',
                os.path.dirname(__file__) + '/docker-compose.yaml',
                k3s,
                modifications=[
                    k3s.create_namespace(namespace_specs=[
                        {'name': 'stacks-1001'},
                        {'name': 'monitoring', 'labels': {'env': 'dev'}},
                    ]),
                ],
            )
    """
    if not namespace_specs:
        return {}

    if type(namespace_specs) != 'list':
        fail("namespace_specs must be a list, got: " + str(type(namespace_specs)))

    # Build namespace YAML manifests
    namespace_yamls = []
    for spec in namespace_specs:
        if type(spec) != 'dict':
            fail("Each namespace spec must be a dict, got: " + str(type(spec)))

        if 'name' not in spec:
            fail("Namespace spec must have 'name' field")

        ns_name = spec['name']
        yaml_lines = [
            'apiVersion: v1',
            'kind: Namespace',
            'metadata:',
            '  name: ' + ns_name,
        ]

        if spec.get('labels'):
            yaml_lines.append('  labels:')
            for k, v in spec['labels'].items():
                yaml_lines.append('    %s: "%s"' % (k, v))

        namespace_yamls.append('\n'.join(yaml_lines))

    all_ns_yaml = '\n---\n'.join(namespace_yamls)

    # Generate unique service name using hash to avoid conflicts
    # when multiple orchestrators create namespaces
    specs_hash = str(abs(hash(str(namespace_specs))))[:8]
    service_name = 'namespace-setup-' + specs_hash

    return {
        'services': {
            service_name: {
                'image': 'bitnami/kubectl:latest',
                'depends_on': ['k3s-apiserver'],
                'volumes': ['k3s-output:/output:ro'],
                'entrypoint': ['/bin/sh'],
                'command': [
                    '-c',
                    '''
echo 'Namespace setup starting...'

echo 'Waiting for kubeconfig to be available...'
while [ ! -f /output/kubeconfig.yaml ]; do
  echo 'Kubeconfig not yet available, waiting...'
  sleep 2
done

echo 'Creating modified kubeconfig for container networking...'
sed 's/127\\.0\\.0\\.1:6443/k3s-apiserver:6443/g' /output/kubeconfig.yaml > /tmp/kubeconfig-internal.yaml

echo 'Creating namespaces...'
cat << 'EOF' | kubectl --kubeconfig=/tmp/kubeconfig-internal.yaml apply -f -
%s
EOF

echo 'Namespaces created successfully'
                    ''' % all_ns_yaml,
                ],
                'restart': 'no',
            },
        },
    }

def enable_in_cluster_config(cc, service_names):
    """
    Generate compose_overrides to inject KUBERNETES_SERVICE_HOST and KUBERNETES_SERVICE_PORT
    environment variables for services using in-cluster authentication.

    In a real Kubernetes cluster, these variables are automatically injected into pods.
    This helper provides them for Docker Compose services connecting to k3s-apiserver.

    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)
        service_names: List of service names that need in-cluster config

    Returns:
        Dict with compose_overrides structure

    Example:
        k3s = cc_import(
            name='k3s-apiserver',
            url='...',
        )

        def cc_export():
            return cc_create(
                'my-app',
                os.path.dirname(__file__) + '/docker-compose.yaml',
                k3s,
                modifications=[
                    k3s.enable_in_cluster_config(service_names=['my-operator']),
                ],
            )
    """
    if not service_names:
        return {}

    if type(service_names) != 'list':
        fail("service_names must be a list, got: " + str(type(service_names)))

    services_config = {}
    for service_name in service_names:
        services_config[service_name] = {
            'environment': {
                'KUBERNETES_SERVICE_HOST': 'k3s-apiserver',
                'KUBERNETES_SERVICE_PORT': '6443',
            },
        }

    return {
        'services': services_config,
    }

def copy_kubeconfig_local(cc, dest_path, resource_name='kubeconfig-copy'):
    """
    Creates a Tilt local_resource that waits for kubeconfig to be synced,
    then copies it to a local destination path for kubectl usage.

    This helper enables orchestrators to get a local copy of the kubeconfig
    for running kubectl commands on their host machine.

    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)
        dest_path: Absolute path where kubeconfig should be copied
                   (e.g., os.path.dirname(__file__) + '/generated-kubeconfig.yaml')
        resource_name: Optional name for the Tilt resource (default: 'kubeconfig-copy')

    Returns:
        None - Creates the local_resource directly

    Example:
        k3s = cc_import(
            name='k3s-apiserver',
            url='...',
        )

        if __file__ == config.main_path:
            master = cc_generate_master_compose(cc_export(), cli_plugins)
            cc_docker_compose(master)

            # Copy kubeconfig for local kubectl usage
            k3s.copy_kubeconfig_local(
                dest_path=os.path.dirname(__file__) + '/generated-kubeconfig.yaml'
            )
    """
    source_path = get_kubeconfig_path(cc)

    local_resource(
        resource_name,
        cmd='''
SOURCE="%s"
DEST="%s"

echo "Waiting for kubeconfig to be synced by k3s-apiserver..."
while [ ! -f "$SOURCE" ]; do
  echo "  Kubeconfig not yet available at $SOURCE, waiting..."
  sleep 2
done

echo "Copying kubeconfig to $DEST"
cp "$SOURCE" "$DEST"
echo "✓ Kubeconfig ready for local kubectl usage at $DEST"
        ''' % (source_path, dest_path),
        resource_deps=['kubeconfig-sync'],
        auto_init=True,
        trigger_mode=TRIGGER_MODE_AUTO,
        labels=['k8s'],
    )

def cc_wire_when(cc):
    """
    Declare conditional wiring rules for k3s-apiserver.

    When grafana is loaded alongside k3s-apiserver, this adds the necessary
    feature toggles to enable Grafana's Kubernetes aggregation and API server
    features, plus the KUBERNETES_SERVICE_HOST/PORT environment variables
    needed for Grafana plugins using in-cluster authentication.

    The aggregator requires proxy client certificates which are provided by
    k3s-apiserver via the wire_when rule in grafana's Tiltfile.

    Args:
        cc: Orchestrator's cc struct (injected by compose_composer)

    Returns:
        Dict mapping dependency names to their modifications
    """
    return {
        # When grafana is loaded, enable Kubernetes features
        'grafana': {
            'services': {
                'grafana': {
                    'environment': {
                        # Enable Kubernetes aggregator and API server features
                        # These require the proxy client certificates mounted by grafana's wire_when
                        # NOTE: compose_composer will concatenate this with existing toggles
                        'GF_FEATURE_TOGGLES_ENABLE': 'kubernetesAggregator,grafanaAPIServerEnsureKubectlAccess',
                        # Provide Kubernetes service discovery for plugins using in-cluster config
                        # (e.g., plugins with kubeconfig: cluster in their provisioning)
                        'KUBERNETES_SERVICE_HOST': 'k3s-apiserver',
                        'KUBERNETES_SERVICE_PORT': '6443',
                    },
                },
            },
        },
    }

def _k3s_test_exports():
    """Returns internal functions for testing. Private to avoid auto-binding."""
    return {
        'register_crds': register_crds,
        'register_webhook': register_webhook,
        'register_admission_config': register_admission_config,
        'register_roles': register_roles,
        'create_namespace': create_namespace,
        'enable_in_cluster_config': enable_in_cluster_config,
        'copy_kubeconfig_local': copy_kubeconfig_local,
    }

