# K3s API Server Tilt Extension
# Provides a standalone k3s API server for development.
#
# Exports:
#   get_compose_path()    - Returns path to the compose file
#   get_kubeconfig_path() - Returns path to the kubeconfig output
#   get_provides()        - What this extension provides (for documentation)

def get_compose_path(file='k3s-apiserver-generic.yaml'):
    """Returns the absolute path to the compose file for this component."""
    return os.path.dirname(__file__) + '/' + file

def compose_file_contents(file='k3s-apiserver-generic.yaml'):
    """Returns the parsed YAML contents of the compose file."""
    return read_yaml(get_compose_path(file))

def get_kubeconfig_path():
    """Returns the absolute path to the kubeconfig file generated by k3s-apiserver."""
    return os.path.dirname(__file__) + '/output/kubeconfig.yaml'

def get_provides():
    """
    Declare what this extension provides.
    Used for documentation and discoverability.
    """
    return {
        'services': [
            {
                'name': 'k3s-apiserver',
                'description': 'Kubernetes API server (k3s)',
                'ports': {'6443': 'Kubernetes API'},
            },
            {
                'name': 'cert-provider',
                'description': 'Certificate generation (one-shot)',
            },
            {
                'name': 'traefik',
                'description': 'Webhook proxy for K8s admission controllers',
                'ports': {'443': 'HTTPS webhooks', '8080': 'Dashboard'},
            },
        ],
        'volumes': [
            {
                'name': 'k3s-certs',
                'description': 'Shared certificates for TLS and API aggregation',
                'paths': {
                    '/api-server-aggregation/': 'Client certs for API aggregation',
                    '/tls/': 'TLS certs for webhooks',
                },
            },
            {
                'name': 'k3s-data',
                'description': 'K3s persistent data (etcd)',
            },
        ],
        'outputs': {
            'kubeconfig': {
                'path': get_kubeconfig_path(),
                'description': 'Kubeconfig for accessing the K3s API server',
            },
        },
    }

# ============================================================================
# Standalone Mode
# ============================================================================

# If loaded directly via 'tilt up', run the compose file
if __file__ == config.main_path:
    docker_compose(get_compose_path())
