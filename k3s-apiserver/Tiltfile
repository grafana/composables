# K3s API Server Tilt Extension
# Provides a standalone k3s API server for development.
#
# Exports:
#   cc_get_plugin()       - Returns plugin struct for compose_composer
#   get_compose_path()    - Returns path to the compose file (legacy)
#   get_kubeconfig_path() - Returns path to the kubeconfig output
#   register_crds()       - Generate compose_overrides to mount CRDs into crd-loader

# Set up extension repo for standalone mode only
if __file__ == config.main_path:
    v1alpha1.extension_repo(
        name='local-tilt-extensions',
        url='file://' + os.path.dirname(__file__) + '/../..'
    )
    v1alpha1.extension(
        name='compose_composer',
        repo_name='local-tilt-extensions',
        repo_path='tilt-extensions/compose_composer'
    )

load('ext://compose_composer', 'cc_local_compose')

def cc_get_plugin():
    """Returns the plugin struct for compose_composer."""
    return cc_local_compose(
        'k3s-apiserver',
        os.path.dirname(__file__) + '/k3s-apiserver-generic.yaml',
        labels=['k8s'],
    )

def get_compose_path(file='k3s-apiserver-generic.yaml'):
    """Returns the absolute path to the compose file for this component."""
    return os.path.dirname(__file__) + '/' + file

def compose_file_contents(file='k3s-apiserver-generic.yaml'):
    """Returns the parsed YAML contents of the compose file."""
    return read_yaml(get_compose_path(file))

def get_kubeconfig_path():
    """Returns the absolute path to the kubeconfig file generated by k3s-apiserver."""
    return os.path.dirname(__file__) + '/output/kubeconfig.yaml'

# ============================================================================
# CRD Registration Helper
# ============================================================================

def register_crds(crd_paths):
    """
    Generate compose_overrides to mount CRDs into the crd-loader service.
    
    This helper keeps CRD-mounting logic encapsulated in k3s-apiserver.
    Callers provide their CRD paths (absolute), and this returns the appropriate
    modification to apply to k3s-apiserver.
    
    Args:
        crd_paths: List of absolute paths to CRD directories/files.
                   Use os.path.dirname(__file__) + '/crds' for paths relative to your Tiltfile.
    
    Returns:
        Dict with compose_overrides structure. When used with dependency() helpers,
        the _target field is added automatically by the wrapper.
    
    Example:
        k3s = dependency(
            name='k3s-apiserver',
            url='...',
            imports=['register_crds'],
        )
        
        crd_mod = k3s.register_crds(crd_paths=[
            os.path.dirname(__file__) + '/definitions',
            os.path.dirname(__file__) + '/crds',
        ])
        
        master = generate_master_compose([k3s, mysql], modifications=[crd_mod])
    """
    volumes = []
    
    for path in crd_paths:
        # Use basename for the mount point under /crds
        mount_name = os.path.basename(path)
        volume_mount = path + ':/crds/' + mount_name + ':ro'
        volumes.append(volume_mount)
    
    if not volumes:
        return {}
    
    return {
        'services': {
            'crd-loader': {
                'volumes': volumes,
            },
        },
    }

# ============================================================================
# Standalone Mode
# ============================================================================

# If loaded directly via 'tilt up', run the compose file
if __file__ == config.main_path:
    docker_compose(get_compose_path())
