# Run All Tests
# ============================================================================

def run_tests():
    print("\n=== register_crds Tests ===")
    test_register_crds_basic()
    test_register_crds_multiple_paths()
    test_register_crds_empty_list()
    test_register_crds_volume_format()
    test_register_crds_unique_mount_points()
    test_register_crds_hash_deterministic()
    test_register_crds_collision_scenario()

    print("\n=== register_webhook Tests ===")
    test_register_webhook_basic()
    test_register_webhook_env_format()
    test_register_webhook_multiple_operators()
    test_register_webhook_default_namespace()
    test_register_webhook_empty_list()
    test_register_webhook_both_services()

    print("\n=== create_namespace Tests ===")
    test_create_namespace_basic()
    test_create_namespace_service_config()
    test_create_namespace_yaml_content()
    test_create_namespace_with_labels()
    test_create_namespace_multiple()
    test_create_namespace_empty_list()
    test_create_namespace_unique_service_names()
    test_create_namespace_deterministic_hash()
    test_create_namespace_kubeconfig_patching()
    test_create_namespace_real_world_slo()

    print("\n" + "=" * 50)
    print("All tests passed!")
    print("=" * 50)

# Run tests
run_tests()

# Dummy resource to satisfy tilt ci
local_resource('tests', cmd='echo "Tests completed"', auto_init=False)
