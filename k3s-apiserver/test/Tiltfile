# Tests for k3s-apiserver composable
# Run with: tilt ci (from this directory)

# ============================================================================
# Environment Variables (configurable ports)
# ============================================================================
# The following environment variables can be set to customize ports:
#   TRAEFIK_PORT           - Traefik HTTPS webhook port (default: 9443)
#   TRAEFIK_DASHBOARD_PORT - Traefik dashboard port (default: 8080)
#   K3S_API_SERVER_PORT    - K3s API server port (default: 6443)
#
# Example: TRAEFIK_PORT=9444 K3S_API_SERVER_PORT=6444 tilt ci

# ============================================================================
# Function Definitions (copied from parent for testing)
# ============================================================================

def register_crds(crd_paths):
    """
    Generate compose_overrides to mount CRDs into the crd-loader service.
    """
    volumes = []

    for path in crd_paths:
        # Use hash of full path to ensure unique mount points
        # Multiple plugins may have directories with the same basename (e.g., 'definitions')
        # The crd-loader does a recursive find, so the actual mount point name doesn't matter
        path_hash = str(abs(hash(path)))
        volume_mount = path + ':/crds/' + path_hash + ':ro'
        volumes.append(volume_mount)

    if not volumes:
        return {}

    return {
        'services': {
            'crd-loader': {
                'volumes': volumes,
            },
        },
    }

def register_webhook(operator_specs):
    """
    Generate compose_overrides to configure webhook operator routing in Traefik.
    """
    if not operator_specs:
        return {}

    # Validate operator specs
    if type(operator_specs) != 'list':
        fail("operator_specs must be a list, got: " + str(type(operator_specs)))

    # Build WEBHOOK_OPERATORS string from specs
    operators = []
    for spec in operator_specs:
        if type(spec) != 'dict':
            fail("Each operator spec must be a dict, got: " + str(type(spec)))

        if 'name' not in spec:
            fail("Operator spec must have 'name' field")

        name = spec['name']
        namespace = spec.get('namespace', 'default')
        # port is for documentation/future use - current implementation uses service discovery

        operators.append(name + ':' + namespace)

    webhook_operators_str = ','.join(operators)

    # Return compose_overrides that set WEBHOOK_OPERATORS environment variable
    # This overrides the default in k3s-apiserver-generic.yaml
    # Using dict format for environment ensures proper merging
    return {
        'services': {
            'cert-provider': {
                'environment': {
                    'WEBHOOK_OPERATORS': webhook_operators_str,
                },
            },
            'traefik': {
                'environment': {
                    'WEBHOOK_OPERATORS': webhook_operators_str,
                },
            },
        },
    }

def create_namespace(namespace_specs):
    """
    Create Kubernetes namespaces in k3s-apiserver.
    """
    if not namespace_specs:
        return {}

    if type(namespace_specs) != 'list':
        fail("namespace_specs must be a list, got: " + str(type(namespace_specs)))

    # Build namespace YAML manifests
    namespace_yamls = []
    for spec in namespace_specs:
        if type(spec) != 'dict':
            fail("Each namespace spec must be a dict, got: " + str(type(spec)))

        if 'name' not in spec:
            fail("Namespace spec must have 'name' field")

        ns_name = spec['name']
        yaml_lines = [
            'apiVersion: v1',
            'kind: Namespace',
            'metadata:',
            '  name: ' + ns_name,
        ]

        if spec.get('labels'):
            yaml_lines.append('  labels:')
            for k, v in spec['labels'].items():
                yaml_lines.append('    %s: "%s"' % (k, v))

        namespace_yamls.append('\n'.join(yaml_lines))

    all_ns_yaml = '\n---\n'.join(namespace_yamls)

    # Generate unique service name using hash to avoid conflicts
    specs_hash = str(abs(hash(str(namespace_specs))))[:8]
    service_name = 'namespace-setup-' + specs_hash

    return {
        'services': {
            service_name: {
                'image': 'bitnami/kubectl:latest',
                'depends_on': ['k3s-apiserver'],
                'volumes': ['k3s-output:/output:ro'],
                'entrypoint': ['/bin/sh'],
                'command': [
                    '-c',
                    '''
echo 'Namespace setup starting...'

echo 'Waiting for kubeconfig to be available...'
while [ ! -f /output/kubeconfig.yaml ]; do
  echo 'Kubeconfig not yet available, waiting...'
  sleep 2
done

echo 'Creating modified kubeconfig for container networking...'
sed 's/127\\.0\\.0\\.1:6443/k3s-apiserver:6443/g' /output/kubeconfig.yaml > /tmp/kubeconfig-internal.yaml

echo 'Creating namespaces...'
cat << 'EOF' | kubectl --kubeconfig=/tmp/kubeconfig-internal.yaml apply -f -
%s
EOF

echo 'Namespaces created successfully'
                    ''' % all_ns_yaml,
                ],
                'restart': 'no',
            },
        },
    }

# ============================================================================
# Test Helpers
# ============================================================================

def assert_equals(actual, expected, msg=""):
    if actual != expected:
        fail_msg = "Expected '{}', got '{}'".format(expected, actual)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

def assert_true(condition, msg=""):
    if not condition:
        fail(msg if msg else "Assertion failed")

def assert_in(item, collection, msg=""):
    if item not in collection:
        fail_msg = "'{}' not in '{}'".format(item, collection)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

# ============================================================================
# register_crds Tests
# ============================================================================

def test_register_crds_basic():
    """Test register_crds with single path."""
    result = register_crds(crd_paths=['/path/to/crds'])
    assert_true('services' in result, "Result should have services key")
    assert_true('crd-loader' in result['services'], "Should target crd-loader service")
    assert_true('volumes' in result['services']['crd-loader'], "Should have volumes")
    assert_equals(len(result['services']['crd-loader']['volumes']), 1)
    print("  [PASS] test_register_crds_basic")

def test_register_crds_multiple_paths():
    """Test register_crds with multiple paths."""
    result = register_crds(crd_paths=['/path/to/crds', '/path/to/definitions'])
    assert_equals(len(result['services']['crd-loader']['volumes']), 2)
    print("  [PASS] test_register_crds_multiple_paths")

def test_register_crds_empty_list():
    """Test register_crds with empty list returns empty dict."""
    result = register_crds(crd_paths=[])
    assert_equals(result, {}, "Empty crd_paths should return empty dict")
    print("  [PASS] test_register_crds_empty_list")

def test_register_crds_volume_format():
    """Test register_crds generates correct volume format."""
    result = register_crds(crd_paths=['/abs/path/to/definitions'])
    volumes = result['services']['crd-loader']['volumes']
    # Should be: /abs/path/to/definitions:/crds/<hash>:ro
    assert_true(volumes[0].startswith('/abs/path/to/definitions:'), "Should start with source path")
    assert_true(':ro' in volumes[0], "Should be read-only mount")
    assert_true(':/crds/' in volumes[0], "Should mount under /crds/")
    print("  [PASS] test_register_crds_volume_format")

def test_register_crds_unique_mount_points():
    """Test register_crds generates unique mount points for different paths."""
    result = register_crds(crd_paths=['/plugin1/definitions', '/plugin2/definitions'])
    volumes = result['services']['crd-loader']['volumes']
    assert_equals(len(volumes), 2, "Should have 2 volume mounts")

    # Extract mount points (the part between first and second colon)
    mount_point_1 = volumes[0].split(':')[1]
    mount_point_2 = volumes[1].split(':')[1]

    # Mount points should be different even though basenames are the same
    assert_true(mount_point_1 != mount_point_2, "Mount points should be unique")
    assert_true(mount_point_1.startswith('/crds/'), "First mount should be under /crds/")
    assert_true(mount_point_2.startswith('/crds/'), "Second mount should be under /crds/")
    print("  [PASS] test_register_crds_unique_mount_points")

def test_register_crds_hash_deterministic():
    """Test register_crds generates deterministic hashes for same path."""
    result1 = register_crds(crd_paths=['/plugin1/definitions'])
    result2 = register_crds(crd_paths=['/plugin1/definitions'])

    volume1 = result1['services']['crd-loader']['volumes'][0]
    volume2 = result2['services']['crd-loader']['volumes'][0]

    assert_equals(volume1, volume2, "Same path should generate same mount point")
    print("  [PASS] test_register_crds_hash_deterministic")

def test_register_crds_collision_scenario():
    """Test register_crds handles the real-world collision scenario."""
    # Simulate service-model and gops-labels both having 'definitions' directories
    result = register_crds(crd_paths=[
        '/home/user/service-model/definitions',
        '/home/user/gops-labels/definitions'
    ])

    volumes = result['services']['crd-loader']['volumes']
    assert_equals(len(volumes), 2, "Should mount both directories")

    # Verify both source paths are present
    assert_true('/home/user/service-model/definitions:' in volumes[0],
                "First volume should have service-model path")
    assert_true('/home/user/gops-labels/definitions:' in volumes[1],
                "Second volume should have gops-labels path")

    # Extract and verify mount points are different
    mount_point_1 = volumes[0].split(':')[1]
    mount_point_2 = volumes[1].split(':')[1]
    assert_true(mount_point_1 != mount_point_2,
                "Directories with same basename should get unique mount points")

    print("  [PASS] test_register_crds_collision_scenario")

# ============================================================================
# register_webhook Tests
# ============================================================================

def test_register_webhook_basic():
    """Test register_webhook with single operator."""
    result = register_webhook(operator_specs=[
        {'name': 'my-operator', 'namespace': 'default', 'port': 8443}
    ])
    assert_true('services' in result, "Result should have services key")
    assert_true('cert-provider' in result['services'], "Should target cert-provider")
    assert_true('traefik' in result['services'], "Should target traefik")
    assert_true('environment' in result['services']['cert-provider'])
    assert_true('environment' in result['services']['traefik'])
    print("  [PASS] test_register_webhook_basic")

def test_register_webhook_env_format():
    """Test register_webhook generates correct WEBHOOK_OPERATORS format."""
    result = register_webhook(operator_specs=[
        {'name': 'op1', 'namespace': 'ns1', 'port': 8443}
    ])
    env = result['services']['traefik']['environment']
    assert_true('WEBHOOK_OPERATORS' in env, "Should set WEBHOOK_OPERATORS")
    assert_equals(env['WEBHOOK_OPERATORS'], 'op1:ns1', "Should be name:namespace format")
    print("  [PASS] test_register_webhook_env_format")

def test_register_webhook_multiple_operators():
    """Test register_webhook with multiple operators."""
    result = register_webhook(operator_specs=[
        {'name': 'op1', 'namespace': 'ns1'},
        {'name': 'op2', 'namespace': 'ns2'},
    ])
    env = result['services']['traefik']['environment']
    assert_equals(env['WEBHOOK_OPERATORS'], 'op1:ns1,op2:ns2', "Should be comma-separated")
    print("  [PASS] test_register_webhook_multiple_operators")

def test_register_webhook_default_namespace():
    """Test register_webhook uses default namespace."""
    result = register_webhook(operator_specs=[
        {'name': 'my-operator'}  # No namespace specified
    ])
    env = result['services']['traefik']['environment']
    assert_equals(env['WEBHOOK_OPERATORS'], 'my-operator:default', "Should use default namespace")
    print("  [PASS] test_register_webhook_default_namespace")

def test_register_webhook_empty_list():
    """Test register_webhook with empty list returns empty dict."""
    result = register_webhook(operator_specs=[])
    assert_equals(result, {}, "Empty operator_specs should return empty dict")
    print("  [PASS] test_register_webhook_empty_list")

def test_register_webhook_both_services():
    """Test register_webhook sets env on both cert-provider and traefik."""
    result = register_webhook(operator_specs=[{'name': 'op1'}])
    cert_env = result['services']['cert-provider']['environment']['WEBHOOK_OPERATORS']
    traefik_env = result['services']['traefik']['environment']['WEBHOOK_OPERATORS']
    assert_equals(cert_env, 'op1:default', "cert-provider should have WEBHOOK_OPERATORS")
    assert_equals(traefik_env, 'op1:default', "traefik should have WEBHOOK_OPERATORS")
    print("  [PASS] test_register_webhook_both_services")

# ============================================================================
# create_namespace Tests
# ============================================================================

def test_create_namespace_basic():
    """Test create_namespace with single namespace."""
    result = create_namespace(namespace_specs=[{'name': 'stacks-1001'}])
    assert_true('services' in result, "Result should have services key")

    # Find the namespace-setup service (name includes hash)
    service_names = list(result['services'].keys())
    assert_equals(len(service_names), 1, "Should have exactly one service")
    assert_true(service_names[0].startswith('namespace-setup-'), "Service name should start with namespace-setup-")
    print("  [PASS] test_create_namespace_basic")

def test_create_namespace_service_config():
    """Test create_namespace creates properly configured service."""
    result = create_namespace(namespace_specs=[{'name': 'test-ns'}])
    service_name = list(result['services'].keys())[0]
    service = result['services'][service_name]

    assert_equals(service['image'], 'bitnami/kubectl:latest', "Should use kubectl image")
    assert_in('k3s-apiserver', service['depends_on'], "Should depend on k3s-apiserver")
    assert_in('k3s-output:/output:ro', service['volumes'], "Should mount k3s-output volume")
    assert_equals(service['restart'], 'no', "Should not restart")
    print("  [PASS] test_create_namespace_service_config")

def test_create_namespace_yaml_content():
    """Test create_namespace generates correct namespace YAML."""
    result = create_namespace(namespace_specs=[{'name': 'my-namespace'}])
    service_name = list(result['services'].keys())[0]
    command = result['services'][service_name]['command'][1]

    assert_in('apiVersion: v1', command, "Should have apiVersion")
    assert_in('kind: Namespace', command, "Should have kind: Namespace")
    assert_in('name: my-namespace', command, "Should have namespace name")
    print("  [PASS] test_create_namespace_yaml_content")

def test_create_namespace_with_labels():
    """Test create_namespace with labels."""
    result = create_namespace(namespace_specs=[
        {'name': 'labeled-ns', 'labels': {'env': 'dev', 'team': 'slo'}}
    ])
    service_name = list(result['services'].keys())[0]
    command = result['services'][service_name]['command'][1]

    assert_in('labels:', command, "Should have labels section")
    assert_in('env: "dev"', command, "Should have env label")
    assert_in('team: "slo"', command, "Should have team label")
    print("  [PASS] test_create_namespace_with_labels")

def test_create_namespace_multiple():
    """Test create_namespace with multiple namespaces."""
    result = create_namespace(namespace_specs=[
        {'name': 'ns1'},
        {'name': 'ns2'},
        {'name': 'ns3'},
    ])
    service_name = list(result['services'].keys())[0]
    command = result['services'][service_name]['command'][1]

    # Should have all three namespaces separated by ---
    assert_in('name: ns1', command, "Should have ns1")
    assert_in('name: ns2', command, "Should have ns2")
    assert_in('name: ns3', command, "Should have ns3")
    assert_in('---', command, "Should have YAML document separator")
    print("  [PASS] test_create_namespace_multiple")

def test_create_namespace_empty_list():
    """Test create_namespace with empty list returns empty dict."""
    result = create_namespace(namespace_specs=[])
    assert_equals(result, {}, "Empty namespace_specs should return empty dict")
    print("  [PASS] test_create_namespace_empty_list")

def test_create_namespace_unique_service_names():
    """Test create_namespace generates unique service names for different specs."""
    result1 = create_namespace(namespace_specs=[{'name': 'ns1'}])
    result2 = create_namespace(namespace_specs=[{'name': 'ns2'}])

    service_name1 = list(result1['services'].keys())[0]
    service_name2 = list(result2['services'].keys())[0]

    assert_true(service_name1 != service_name2, "Different specs should get unique service names")
    print("  [PASS] test_create_namespace_unique_service_names")

def test_create_namespace_deterministic_hash():
    """Test create_namespace generates deterministic hash for same specs."""
    specs = [{'name': 'stacks-1001'}]
    result1 = create_namespace(namespace_specs=specs)
    result2 = create_namespace(namespace_specs=specs)

    service_name1 = list(result1['services'].keys())[0]
    service_name2 = list(result2['services'].keys())[0]

    assert_equals(service_name1, service_name2, "Same specs should generate same service name")
    print("  [PASS] test_create_namespace_deterministic_hash")

def test_create_namespace_kubeconfig_patching():
    """Test create_namespace patches kubeconfig for container networking."""
    result = create_namespace(namespace_specs=[{'name': 'test-ns'}])
    service_name = list(result['services'].keys())[0]
    command = result['services'][service_name]['command'][1]

    # Should patch 127.0.0.1:6443 to k3s-apiserver:6443
    assert_in('127\\.0\\.0\\.1:6443', command, "Should patch localhost address")
    assert_in('k3s-apiserver:6443', command, "Should use k3s-apiserver service name")
    print("  [PASS] test_create_namespace_kubeconfig_patching")

def test_create_namespace_real_world_slo():
    """Test create_namespace with SLO's stacks-1001 pattern."""
    result = create_namespace(namespace_specs=[
        {'name': 'stacks-1001', 'labels': {'stack-id': '1001'}}
    ])
    service_name = list(result['services'].keys())[0]
    service = result['services'][service_name]
    command = service['command'][1]

    # Verify SLO's namespace pattern works
    assert_in('name: stacks-1001', command, "Should create stacks-1001 namespace")
    assert_in('stack-id: "1001"', command, "Should have stack-id label")
    print("  [PASS] test_create_namespace_real_world_slo")

