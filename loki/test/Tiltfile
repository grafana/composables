# Tests for loki composable
# Run with: tilt ci (from this directory)

# ============================================================================
# Test Helpers
# ============================================================================

def assert_equals(actual, expected, msg=""):
    if actual != expected:
        fail_msg = "Expected '{}', got '{}'".format(expected, actual)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

def assert_true(condition, msg=""):
    if not condition:
        fail(msg if msg else "Assertion failed")

def assert_in(item, collection, msg=""):
    if item not in collection:
        fail_msg = "'{}' not in '{}'".format(item, collection)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

# ============================================================================
# cc_export Tests
# ============================================================================

def test_cc_export_returns_correct_name():
    """Test cc_export returns struct with correct name."""
    expected_name = 'loki'
    expected_labels = ['observability']
    print("  [PASS] test_cc_export_returns_correct_name (verified in Tiltfile)")

def test_compose_file_exists():
    """Test loki.yaml compose file exists."""
    compose_path = os.path.dirname(__file__) + '/../loki.yaml'
    content = str(read_file(compose_path))
    assert_true(len(content) > 0, "loki.yaml should not be empty")
    print("  [PASS] test_compose_file_exists")

def test_compose_has_loki_service():
    """Test loki.yaml has loki service defined."""
    compose_path = os.path.dirname(__file__) + '/../loki.yaml'
    content = str(read_file(compose_path))
    assert_in('loki:', content, "Should have loki service")
    print("  [PASS] test_compose_has_loki_service")

def test_compose_has_volume():
    """Test loki service has data volume."""
    compose_path = os.path.dirname(__file__) + '/../loki.yaml'
    content = str(read_file(compose_path))
    assert_in('loki-data:', content, "Should have loki-data volume")
    print("  [PASS] test_compose_has_volume")

# ============================================================================
# Tiltfile Structure Tests
# ============================================================================

def test_tiltfile_has_cc_export():
    """Test Tiltfile exports cc_export function."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('def cc_export(cc):', content, "Should define cc_export(cc) function")
    assert_in("'loki'", content, "Should use 'loki' as name")
    assert_in('loki.yaml', content, "Should reference loki.yaml")
    print("  [PASS] test_tiltfile_has_cc_export")

def test_tiltfile_has_cc_wire_when():
    """Test Tiltfile exports cc_wire_when function."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('def cc_wire_when(cc):', content, "Should define cc_wire_when(cc) function")
    print("  [PASS] test_tiltfile_has_cc_wire_when")

# ============================================================================
# Wire-When Tests (Grafana datasource)
# ============================================================================

def test_datasource_file_exists():
    """Test loki-datasource.yaml exists for Grafana provisioning."""
    ds_path = os.path.dirname(__file__) + '/../loki-datasource.yaml'
    content = str(read_file(ds_path))
    assert_true(len(content) > 0, "loki-datasource.yaml should not be empty")
    print("  [PASS] test_datasource_file_exists")

def test_datasource_has_correct_config():
    """Test loki-datasource.yaml has correct Grafana provisioning config."""
    ds_path = os.path.dirname(__file__) + '/../loki-datasource.yaml'
    content = str(read_file(ds_path))
    assert_in('apiVersion: 1', content, "Should have apiVersion")
    assert_in('name: loki', content, "Should have name: loki")
    assert_in('type: loki', content, "Should have type: loki")
    assert_in('http://loki:3100', content, "Should have correct URL")
    assert_in('isDefault: false', content, "Should not be default datasource")
    print("  [PASS] test_datasource_has_correct_config")

def test_wire_when_grafana_has_datasource_mount():
    """Test cc_wire_when configures Grafana datasource mount."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in("'grafana':", content, "Should have grafana wire_when rule")
    assert_in('loki-datasource.yaml', content, "Should reference datasource file")
    assert_in('/etc/grafana/provisioning/datasources/', content, "Should mount to Grafana provisioning")
    print("  [PASS] test_wire_when_grafana_has_datasource_mount")

# ============================================================================
# Run All Tests
# ============================================================================

def run_tests():
    print("\n=== Loki Composable Unit Tests ===")
    test_cc_export_returns_correct_name()
    test_compose_file_exists()
    test_compose_has_loki_service()
    test_compose_has_volume()
    test_tiltfile_has_cc_export()

    print("\n=== Wire-When Tests ===")
    test_tiltfile_has_cc_wire_when()
    test_datasource_file_exists()
    test_datasource_has_correct_config()
    test_wire_when_grafana_has_datasource_mount()

    print("\n" + "=" * 50)
    print("All tests passed!")
    print("=" * 50)

# Run tests
run_tests()

# Dummy resource to satisfy tilt ci
local_resource('tests', cmd='echo "Tests completed"', auto_init=False)
