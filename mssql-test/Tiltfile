# MS SQL Server Test Tilt Extension
# Provides MS SQL Server test database for SQL testing.
#
# Exports:
#   cc_export(cc)  - Returns plugin struct for compose_composer

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'mssql-test',
        os.path.dirname(__file__) + '/mssql-test.yaml',
        labels=['sql-test'],
    )
