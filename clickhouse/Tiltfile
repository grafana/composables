# ClickHouse Tilt Extension
# Provides ClickHouse database for SQL testing.
#
# Exports:
#   cc_export(cc)  - Returns plugin struct for compose_composer

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'clickhouse',
        os.path.dirname(__file__) + '/clickhouse.yaml',
        labels=['sql-test'],
    )

