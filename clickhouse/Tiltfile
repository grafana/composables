# ClickHouse Tilt Extension
# Provides ClickHouse database for SQL testing.
#
# Exports:
#   cc_export()    - Returns plugin struct for compose_composer

load('ext://compose_composer', 'cc_init')

cc = cc_init('clickhouse')

def cc_export():
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'clickhouse',
        os.path.dirname(__file__) + '/clickhouse.yaml',
        labels=['sql-test'],
    )

