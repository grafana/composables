def test_configure_admin_returns_marker_and_override():
    """Test configure_admin returns both marker and compose override."""
    result = configure_admin(username='myadmin', password='secret')

    # Check marker
    assert_true('_grafana_admin_config' in result, "Should have admin config marker")
    assert_equals(result['_grafana_admin_config']['username'], 'myadmin', "Marker should have username")
    assert_equals(result['_grafana_admin_config']['password'], 'secret', "Marker should have password")

    # Check target
    assert_equals(result['_target'], 'grafana', "Target should be grafana")

    # Check compose override
    assert_true('services' in result, "Should have services key")
    grafana_env = result['services']['grafana']['environment']
    assert_equals(grafana_env['GF_SECURITY_ADMIN_USER'], 'myadmin', "Should set GF_SECURITY_ADMIN_USER")
    assert_equals(grafana_env['GF_SECURITY_ADMIN_PASSWORD'], 'secret', "Should set GF_SECURITY_ADMIN_PASSWORD")
    assert_equals(grafana_env['GF_AUTH_BASIC_ENABLED'], 'true', "Should enable basic auth")
    print("  [PASS] test_configure_admin_returns_marker_and_override")

def test_configure_admin_defaults():
    """Test configure_admin uses admin/admin defaults."""
    result = configure_admin()
    assert_equals(result['_grafana_admin_config']['username'], 'admin', "Default username should be admin")
    assert_equals(result['_grafana_admin_config']['password'], 'admin', "Default password should be admin")
    grafana_env = result['services']['grafana']['environment']
    assert_equals(grafana_env['GF_SECURITY_ADMIN_USER'], 'admin', "Default GF_SECURITY_ADMIN_USER should be admin")
    assert_equals(grafana_env['GF_SECURITY_ADMIN_PASSWORD'], 'admin', "Default GF_SECURITY_ADMIN_PASSWORD should be admin")
    assert_equals(grafana_env['GF_AUTH_BASIC_ENABLED'], 'true', "Should enable basic auth by default")
    print("  [PASS] test_configure_admin_defaults")

# ============================================================================
# process_accumulated_modifications - User Provisioning Tests
# ============================================================================

def test_process_accumulated_modifications_users():
    """Test process_accumulated_modifications creates grafana-user-setup service."""
    mods = [
        {
            '_grafana_user_specs': [
                {'username': 'testuser', 'password': 'testpass', 'role': 'Editor'},
            ],
            '_target': 'grafana',
        },
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    assert_true('services' in result, "Result should have services key")
    assert_true('grafana-user-setup' in result['services'], "Should create grafana-user-setup service")

    svc = result['services']['grafana-user-setup']
    assert_equals(svc['image'], 'alpine:latest', "Should use alpine image")
    assert_true('grafana' in svc['depends_on'], "Should depend on grafana")
    assert_equals(svc['depends_on']['grafana']['condition'], 'service_healthy', "Should wait for healthy")
    assert_equals(svc['restart'], 'on-failure', "Should restart on failure")

    # Check script contains user
    script = svc['command'][1]
    assert_contains(script, 'testuser', "Script should contain username")
    assert_contains(script, 'testpass', "Script should contain password")
    assert_contains(script, 'Editor', "Script should contain role")
    print("  [PASS] test_process_accumulated_modifications_users")

def test_process_accumulated_modifications_users_deduplicates():
    """Test process_accumulated_modifications deduplicates users by username."""
    mods = [
        {
            '_grafana_user_specs': [
                {'username': 'dupuser', 'password': 'pass1', 'role': 'Editor'},
            ],
            '_target': 'grafana',
        },
        {
            '_grafana_user_specs': [
                {'username': 'dupuser', 'password': 'pass2', 'role': 'Admin'},  # Duplicate
            ],
            '_target': 'grafana',
        },
        {
            '_grafana_user_specs': [
                {'username': 'uniqueuser', 'password': 'pass3'},
            ],
            '_target': 'grafana',
        },
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    script = result['services']['grafana-user-setup']['command'][1]
    # dupuser should appear in provisioning blocks but only once as a provisioning target
    # uniqueuser should also appear
    assert_contains(script, 'uniqueuser', "Should contain unique user")

    # Count provisioning blocks - each user gets a "--- Provisioning user: X ---" header
    dup_count = script.count('--- Provisioning user: dupuser ---')
    assert_equals(dup_count, 1, "Duplicate user should be deduplicated to 1 block")
    print("  [PASS] test_process_accumulated_modifications_users_deduplicates")

def test_process_accumulated_modifications_admin_config():
    """Test process_accumulated_modifications uses admin config from configure_admin."""
    mods = [
        {
            '_grafana_admin_config': {'username': 'myadmin', 'password': 'mysecret'},
            '_target': 'grafana',
        },
        {
            '_grafana_user_specs': [
                {'username': 'testuser', 'password': 'testpass'},
            ],
            '_target': 'grafana',
        },
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    svc = result['services']['grafana-user-setup']
