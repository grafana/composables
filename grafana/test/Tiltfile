# Tiltfile Structure Tests (verify source has new helpers)
# ============================================================================

def test_tiltfile_has_passthrough_env():
    """Test Tiltfile defines passthrough_env function."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('def passthrough_env(cc, var_names):', content,
              "Should define passthrough_env(cc, var_names) function")
    assert_in('_grafana_passthrough_env', content, "Should use _grafana_passthrough_env marker")
    print("  [PASS] test_tiltfile_has_passthrough_env")

