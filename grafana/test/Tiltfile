    print("  [PASS] test_process_accumulated_modifications_users_rbac")

def test_process_accumulated_modifications_combined():
    """Test process_accumulated_modifications handles both aggregator and users."""
    mods = [
        {
            '_aggregator_api_groups': [
                {'group': 'test.ext.grafana.com', 'version': 'v1alpha1'}
            ],
            '_target': 'grafana',
        },
        {
            '_grafana_user_specs': [
                {'username': 'testuser', 'password': 'testpass', 'role': 'Editor'},
            ],
            '_target': 'grafana',
        },
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    # Should have both services
    assert_true('aggregator-config' in result['services'], "Should have aggregator-config service")
    assert_true('grafana-user-setup' in result['services'], "Should have grafana-user-setup service")
    assert_true('grafana' in result['services'], "Should have grafana service (from aggregator depends_on)")
    assert_equals(result['_target'], 'grafana', "Target should be grafana")

    # Verify aggregator still works
    agg_script = result['services']['aggregator-config']['command'][1]
    assert_contains(agg_script, 'test.ext.grafana.com', "Aggregator should contain group")

    # Verify user setup works
    user_script = result['services']['grafana-user-setup']['command'][1]
    assert_contains(user_script, 'testuser', "User setup should contain username")
    print("  [PASS] test_process_accumulated_modifications_combined")

