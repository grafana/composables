    assert_equals(env['SECRET'], '$SECRET', "Should have passthrough env")
    assert_equals(env['GF_LOG_LEVEL'], 'info', "Should have registered env")
    assert_equals(env['GF_INSTALL_PLUGINS'], 'plugin-x', "Should have install plugins")
    print("  [PASS] test_process_accumulated_env_with_users")

