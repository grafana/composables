# Tests for grafana composable
# Run with: tilt ci (from this directory)

# ============================================================================
# Function Definitions (copied from parent for testing)
# ============================================================================

def provision_plugins(plugin_paths=[]):
    """
    Helper function to mount plugin provisioning files into Grafana.

    Args:
        plugin_paths: List of directory paths containing plugin provisioning files
                     Each path should contain YAML files for plugin configuration

    Returns:
        Dict with compose_overrides to mount the plugin directories

    Example:
        grafana.provision_plugins([
            '/path/to/irm/dev/provisioning_files/oncall',
            '/path/to/irm/dev/provisioning_files/incident',
        ])
    """
    if not plugin_paths:
        return {}

    # Build volume mounts for each plugin path
    volumes = []
    for i, path in enumerate(plugin_paths):
        # Mount each directory to a unique location in grafana provisioning
        volumes.append(path + ':/etc/grafana/provisioning/plugins/plugin-' + str(i) + ':ro')

    return {
        'services': {
            'grafana': {
                'volumes': volumes,
            },
        },
    }

def register_aggregator_config(api_groups):
    """
    Declare API groups for Grafana AppPlatform aggregation.

    This helper registers API groups that should be aggregated by Grafana.
    Multiple composables can call this function, and all api_groups will be
    accumulated and written to a single configuration file.

    Args:
        api_groups: List of dicts, each with:
            - group: str     - API group (e.g., 'servicemodel.ext.grafana.com')
            - version: str   - API version (e.g., 'v1alpha1')
            - host: str      - API server hostname (default: 'k3s-apiserver')
            - port: int      - API server port (default: 6443)

    Returns:
        Dict with _aggregator_api_groups marker for compose_composer to process.
        The actual aggregator-config service is created by process_accumulated_modifications().

    Example:
        grafana = cc_import(
            name='grafana',
            url='...',
        )

        def cc_export():
            return cc_create(
                'my-app',
                os.path.dirname(__file__) + '/docker-compose.yaml',
                grafana,
                modifications=[
                    grafana.register_aggregator_config(api_groups=[
                        {
                            'group': 'servicemodel.ext.grafana.com',
                            'version': 'v1alpha1',
                            'host': 'k3s-apiserver',
                            'port': 6443,
                        },
                    ]),
                ],
            )
    """
    if type(api_groups) != 'list':
        fail("api_groups must be a list, got: " + str(type(api_groups)))

    if not api_groups:
        fail("api_groups cannot be empty - provide at least one API group")

    # Validate api_groups structure
    for group_spec in api_groups:
        if type(group_spec) != 'dict':
            fail("Each api_group must be a dict, got: " + str(type(group_spec)))

        if 'group' not in group_spec or 'version' not in group_spec:
            fail("Each api_group must have 'group' and 'version' fields")

    # Return a marker that will be processed by process_accumulated_modifications()
    return {
        '_aggregator_api_groups': api_groups,
        '_target': 'grafana',
    }


def _build_aggregator_config_service(all_api_groups):
    """
    Internal: Build the aggregator-config service with all accumulated api_groups.
    """
    yaml_lines = []
    for group_spec in all_api_groups:
        host = group_spec.get('host', 'k3s-apiserver')
        port = group_spec.get('port', 6443)

        yaml_lines.append("- group: " + group_spec['group'])
        yaml_lines.append("  version: " + group_spec['version'])
        yaml_lines.append("  host: " + host)
        yaml_lines.append("  port: " + str(port))

    yaml_content = "\n".join(yaml_lines)

    # Also add depends_on from grafana to aggregator-config so grafana waits for the config file
    return {
        'services': {
            'aggregator-config': {
                'image': 'alpine:latest',
                'entrypoint': ['/bin/sh'],
                'command': [
                    '-c',
                    '''
echo 'Creating aggregator config...'
cat << 'EOF' > /certs/aggregator-config.yaml
%s
EOF
echo 'Aggregator config created successfully'
cat /certs/aggregator-config.yaml
                    ''' % yaml_content,
                ],
                'depends_on': ['k3s-apiserver'],
                'volumes': ['k3s-certs:/certs'],
                'restart': 'no',
            },
            'grafana': {
                'depends_on': {'aggregator-config': {'condition': 'service_started'}},
            },
        },
    }


def provision_users(user_specs):
    """
    Declare users to provision in Grafana via the HTTP API (test copy without cc param).
    """
    if type(user_specs) != 'list':
        fail("user_specs must be a list, got: " + str(type(user_specs)))

    if not user_specs:
        fail("user_specs cannot be empty - provide at least one user spec")

    for spec in user_specs:
        if type(spec) != 'dict':
            fail("Each user spec must be a dict, got: " + str(type(spec)))

        if 'username' not in spec:
            fail("User spec missing required 'username' field: " + str(spec))

        if 'password' not in spec:
            fail("User spec missing required 'password' field for user: " + spec['username'])

    return {
        '_grafana_user_specs': user_specs,
        '_target': 'grafana',
    }


def configure_admin(username='admin', password='admin'):
    """
    Set admin credentials for Grafana and the user provisioning service (test copy without cc param).
    """
    return {
        '_grafana_admin_config': {'username': username, 'password': password},
        '_target': 'grafana',
        'services': {
            'grafana': {
                'environment': {
                    'GF_SECURITY_ADMIN_USER': username,
                    'GF_SECURITY_ADMIN_PASSWORD': password,
                    'GF_AUTH_BASIC_ENABLED': 'true',
                },
            },
        },
    }


def _build_user_provisioning_service(all_user_specs, admin_config):
    """
    Internal: Build the grafana-user-setup service with all accumulated user specs.
    Note: Shell variables use $$ because Docker Compose interpolates $ in commands.
    """
    admin_user = admin_config.get('username', 'admin')
    admin_pass = admin_config.get('password', 'admin')

    # Build per-user provisioning script blocks
    user_blocks = []
    for spec in all_user_specs:
        username = spec['username']
        password = spec['password']
        role = spec.get('role', 'Viewer')
        email = spec.get('email', username + '@localhost')
        name = spec.get('name', username)
        rbac_roles = spec.get('rbac_roles', [])

        block = '''
echo "--- Provisioning user: %s ---"

# Check if user already exists
EXISTING=$$(curl -s -o /dev/null -w "%%{http_code}" \\
  -u "$$ADMIN_USER:$$ADMIN_PASS" \\
  "$$GRAFANA_URL/api/users/lookup?loginOrEmail=%s")

if [ "$$EXISTING" = "200" ]; then
  echo "User %s already exists, fetching ID..."
  USER_ID=$$(curl -s -u "$$ADMIN_USER:$$ADMIN_PASS" \\
    "$$GRAFANA_URL/api/users/lookup?loginOrEmail=%s" | jq -r '.id')
else
  echo "Creating user %s..."
  CREATE_RESP=$$(curl -s -u "$$ADMIN_USER:$$ADMIN_PASS" \\
    -H "Content-Type: application/json" \\
    -d '{"login":"%s","password":"%s","email":"%s","name":"%s","OrgId":1}' \\
    "$$GRAFANA_URL/api/admin/users")
  echo "  Create response: $$CREATE_RESP"
  USER_ID=$$(echo "$$CREATE_RESP" | jq -r '.id')
fi

if [ -z "$$USER_ID" ] || [ "$$USER_ID" = "null" ]; then
  echo "  ERROR: Failed to get user ID for %s"
else
  echo "  User ID: $$USER_ID"

  # Set org role
  echo "  Setting org role to %s..."
  curl -s -u "$$ADMIN_USER:$$ADMIN_PASS" \\
    -X PATCH -H "Content-Type: application/json" \\
    -d '{"role":"%s"}' \\
    "$$GRAFANA_URL/api/org/users/$$USER_ID"
  echo ""''' % (username, username, username, username, username,
                username, password, email, name, username, role, role)

        for rbac_role in rbac_roles:
            block += '''

  # Assign RBAC role: %s
  echo "  Assigning RBAC role: %s..."
  ROLE_UID=$$(curl -s -u "$$ADMIN_USER:$$ADMIN_PASS" \\
    "$$GRAFANA_URL/api/access-control/roles" | \\
    jq -r '.[] | select(.name=="%s") | .uid')
  if [ -n "$$ROLE_UID" ] && [ "$$ROLE_UID" != "null" ]; then
    curl -s -u "$$ADMIN_USER:$$ADMIN_PASS" \\
      -X POST -H "Content-Type: application/json" \\
      -d "{\\"roleUid\\":\\"$$ROLE_UID\\",\\"global\\":false}" \\
      "$$GRAFANA_URL/api/access-control/users/$$USER_ID/roles"
    echo ""
    echo "    Assigned role UID: $$ROLE_UID"
  else
    echo "    WARNING: RBAC role '%s' not found (requires Grafana Enterprise)"
  fi''' % (rbac_role, rbac_role, rbac_role, rbac_role)

        block += '''
fi
echo "--- Done: %s ---"
''' % username

        user_blocks.append(block)

    script_body = '\n'.join(user_blocks)

    full_script = '''
set -e

echo "=== Grafana User Provisioning ==="
echo "Grafana URL: $$GRAFANA_URL"
echo "Admin user: $$ADMIN_USER"

# Install dependencies
apk add --no-cache curl jq > /dev/null 2>&1

# Wait for Grafana API to be fully ready (healthcheck may pass before API is ready)
echo "Waiting for Grafana API..."
RETRIES=0
MAX_RETRIES=30
while [ $$RETRIES -lt $$MAX_RETRIES ]; do
  if curl -s -u "$$ADMIN_USER:$$ADMIN_PASS" "$$GRAFANA_URL/api/org" > /dev/null 2>&1; then
    echo "Grafana API is ready"
    break
  fi
  RETRIES=$$(($$RETRIES + 1))
  echo "  Attempt $$RETRIES/$$MAX_RETRIES - waiting..."
  sleep 2
done

if [ $$RETRIES -eq $$MAX_RETRIES ]; then
  echo "ERROR: Grafana API did not become ready"
  exit 1
fi

%s

echo ""
echo "=== User provisioning complete ==="
''' % script_body

    return {
        'services': {
            'grafana-user-setup': {
                'image': 'alpine:latest',
                'depends_on': {
                    'grafana': {'condition': 'service_healthy'},
                },
                'environment': {
                    'GRAFANA_URL': 'http://grafana:3000',
                    'ADMIN_USER': admin_user,
                    'ADMIN_PASS': admin_pass,
                },
                'entrypoint': ['/bin/sh'],
                'command': ['-c', full_script],
                'restart': 'on-failure',
            },
        },
    }


def passthrough_env(var_names):
    """Forward host environment variables into Grafana (test copy without cc param)."""
    if type(var_names) != 'list':
        fail("var_names must be a list, got: " + str(type(var_names)))
    return {
        '_grafana_passthrough_env': var_names,
        '_target': 'grafana',
    }


def register_environment(env_dict):
    """Set environment variables on the Grafana container (test copy without cc param)."""
    if type(env_dict) != 'dict':
        fail("env_dict must be a dict, got: " + str(type(env_dict)))
    return {
        '_grafana_environment': env_dict,
        '_target': 'grafana',
    }


def install_plugins(plugin_urls):
    """Install Grafana plugins (test copy without cc param)."""
    if type(plugin_urls) != 'list':
        fail("plugin_urls must be a list, got: " + str(type(plugin_urls)))
    return {
        '_grafana_install_plugins': plugin_urls,
        '_target': 'grafana',
    }


def process_accumulated_modifications(all_modifications, orchestrator_dir):
    """
    Extract accumulated requirements from all modifications and generate services.
    """
    result = {}

    # --- Pass 1: Extract api_groups for aggregator-config ---
    all_api_groups = []
    seen_groups = {}

    for mod in all_modifications:
        if type(mod) == 'dict' and '_aggregator_api_groups' in mod:
            api_groups = mod['_aggregator_api_groups']
            if type(api_groups) == 'list':
                for group_spec in api_groups:
                    group_name = group_spec.get('group', '')
                    if group_name and group_name not in seen_groups:
                        seen_groups[group_name] = True
                        all_api_groups.append(group_spec)

    if all_api_groups:
        result = _build_aggregator_config_service(all_api_groups)

    # --- Pass 2: Extract user specs for grafana-user-setup ---
    all_user_specs = []
    seen_users = {}
    admin_config = {}

    for mod in all_modifications:
        if type(mod) != 'dict':
            continue

        if '_grafana_user_specs' in mod:
            user_specs = mod['_grafana_user_specs']
            if type(user_specs) == 'list':
                for spec in user_specs:
                    username = spec.get('username', '')
                    if username and username not in seen_users:
                        seen_users[username] = True
                        all_user_specs.append(spec)

        if '_grafana_admin_config' in mod:
            admin_config = mod['_grafana_admin_config']

    if all_user_specs:
        user_mod = _build_user_provisioning_service(all_user_specs, admin_config)

        if 'services' in result:
            for svc_name, svc_config in user_mod.get('services', {}).items():
                result['services'][svc_name] = svc_config
        else:
            result = user_mod

    # --- Pass 3: Extract passthrough env vars ---
    all_passthrough_vars = []
    seen_vars = {}

    for mod in all_modifications:
        if type(mod) != 'dict':
            continue
        if '_grafana_passthrough_env' in mod:
            var_names = mod['_grafana_passthrough_env']
            if type(var_names) == 'list':
                for name in var_names:
                    if name and name not in seen_vars:
                        seen_vars[name] = True
                        all_passthrough_vars.append(name)

    if all_passthrough_vars:
        env_map = {}
        for name in sorted(all_passthrough_vars):
            env_map[name] = '$' + name

        if 'services' in result:
            if 'grafana' in result['services']:
                if 'environment' in result['services']['grafana']:
                    for k, v in env_map.items():
                        result['services']['grafana']['environment'][k] = v
                else:
                    result['services']['grafana']['environment'] = env_map
            else:
                result['services']['grafana'] = {'environment': env_map}
        else:
            result = {'services': {'grafana': {'environment': env_map}}}

    # --- Pass 4: Extract registered environment vars ---
    all_env_vars = {}

    for mod in all_modifications:
        if type(mod) != 'dict':
            continue
        if '_grafana_environment' in mod:
            env_dict = mod['_grafana_environment']
            if type(env_dict) == 'dict':
                for k, v in env_dict.items():
                    all_env_vars[k] = v

    if all_env_vars:
        if 'services' in result:
            if 'grafana' in result['services']:
                if 'environment' in result['services']['grafana']:
                    for k, v in all_env_vars.items():
                        result['services']['grafana']['environment'][k] = v
                else:
                    result['services']['grafana']['environment'] = all_env_vars
            else:
                result['services']['grafana'] = {'environment': all_env_vars}
        else:
            result = {'services': {'grafana': {'environment': all_env_vars}}}

    # --- Pass 5: Extract install_plugins ---
    all_install_plugins = []
    seen_plugins = {}

    for mod in all_modifications:
        if type(mod) != 'dict':
            continue
        if '_grafana_install_plugins' in mod:
            plugin_urls = mod['_grafana_install_plugins']
            if type(plugin_urls) == 'list':
                for url in plugin_urls:
                    if url and url not in seen_plugins:
                        seen_plugins[url] = True
                        all_install_plugins.append(url)

    if all_install_plugins:
        install_val = ','.join(all_install_plugins)
        if 'services' in result:
            if 'grafana' in result['services']:
                if 'environment' in result['services']['grafana']:
                    result['services']['grafana']['environment']['GF_INSTALL_PLUGINS'] = install_val
                else:
                    result['services']['grafana']['environment'] = {'GF_INSTALL_PLUGINS': install_val}
            else:
                result['services']['grafana'] = {'environment': {'GF_INSTALL_PLUGINS': install_val}}
        else:
            result = {'services': {'grafana': {'environment': {'GF_INSTALL_PLUGINS': install_val}}}}

    if not result:
        return {}

    result['_target'] = 'grafana'
    return result

# ============================================================================
# Test Helpers
# ============================================================================

def assert_equals(actual, expected, msg=""):
    if actual != expected:
        fail_msg = "Expected '{}', got '{}'".format(expected, actual)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

def assert_true(condition, msg=""):
    if not condition:
        fail(msg if msg else "Assertion failed")

def assert_in(item, collection, msg=""):
    if item not in collection:
        fail_msg = "'{}' not in '{}'".format(item, collection)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

def assert_contains(haystack, needle, msg=""):
    """Check if needle substring is in haystack string."""
    if needle not in haystack:
        fail_msg = "'{}' not found in '{}'".format(needle, haystack)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

# ============================================================================
# provision_plugins Tests
# ============================================================================

def test_provision_plugins_empty_list():
    """Test provision_plugins with empty list returns empty dict."""
    result = provision_plugins(plugin_paths=[])
    assert_equals(result, {}, "Empty plugin_paths should return empty dict")
    print("  [PASS] test_provision_plugins_empty_list")

def test_provision_plugins_single_path():
    """Test provision_plugins with single path."""
    result = provision_plugins(plugin_paths=['/path/to/plugin1'])
    assert_true('services' in result, "Result should have services key")
    assert_true('grafana' in result['services'], "Should target grafana service")
    assert_true('volumes' in result['services']['grafana'], "Should have volumes")
    assert_equals(len(result['services']['grafana']['volumes']), 1)
    print("  [PASS] test_provision_plugins_single_path")

def test_provision_plugins_multiple_paths():
    """Test provision_plugins with multiple paths."""
    result = provision_plugins(plugin_paths=[
        '/path/to/plugin1',
        '/path/to/plugin2',
        '/path/to/plugin3'
    ])
    volumes = result['services']['grafana']['volumes']
    assert_equals(len(volumes), 3, "Should have 3 volume mounts")
    print("  [PASS] test_provision_plugins_multiple_paths")

def test_provision_plugins_volume_format():
    """Test provision_plugins generates correct volume format."""
    result = provision_plugins(plugin_paths=['/abs/path/to/provisioning'])
    volumes = result['services']['grafana']['volumes']
    # Should be: /abs/path/to/provisioning:/etc/grafana/provisioning/plugins/plugin-0:ro
    assert_true(volumes[0].startswith('/abs/path/to/provisioning:'), "Should start with source path")
    assert_contains(volumes[0], ':/etc/grafana/provisioning/plugins/plugin-', "Should mount to provisioning plugins dir")
    assert_true(':ro' in volumes[0], "Should be read-only mount")
    print("  [PASS] test_provision_plugins_volume_format")

def test_provision_plugins_unique_mount_points():
    """Test provision_plugins generates unique mount points for multiple paths."""
    result = provision_plugins(plugin_paths=[
        '/path/to/plugin1',
        '/path/to/plugin2'
    ])
    volumes = result['services']['grafana']['volumes']
    # Should have plugin-0 and plugin-1
    assert_contains(volumes[0], 'plugin-0', "First should be plugin-0")
    assert_contains(volumes[1], 'plugin-1', "Second should be plugin-1")
    print("  [PASS] test_provision_plugins_unique_mount_points")

# ============================================================================
# register_aggregator_config Tests
# ============================================================================

def test_register_aggregator_config_returns_marker():
    """Test register_aggregator_config returns a marker dict."""
    result = register_aggregator_config(api_groups=[
        {
            'group': 'servicemodel.ext.grafana.com',
            'version': 'v1alpha1',
            'host': 'k3s-apiserver',
            'port': 6443,
        }
    ])
    assert_true('_aggregator_api_groups' in result, "Result should have _aggregator_api_groups marker")
    assert_true('_target' in result, "Result should have _target field")
    assert_equals(result['_target'], 'grafana', "Target should be grafana")
    assert_equals(len(result['_aggregator_api_groups']), 1, "Should have 1 api_group")
    print("  [PASS] test_register_aggregator_config_returns_marker")

def test_register_aggregator_config_preserves_api_groups():
    """Test register_aggregator_config preserves api_groups in marker."""
    api_groups = [
        {
            'group': 'test.ext.grafana.com',
            'version': 'v1',
            'host': 'localhost',
            'port': 8080,
        }
    ]
    result = register_aggregator_config(api_groups=api_groups)
    # Verify api_groups are preserved in the marker
    marker_groups = result['_aggregator_api_groups']
    assert_equals(marker_groups[0]['group'], 'test.ext.grafana.com', "Should preserve group")
    assert_equals(marker_groups[0]['version'], 'v1', "Should preserve version")
    assert_equals(marker_groups[0]['host'], 'localhost', "Should preserve host")
    assert_equals(marker_groups[0]['port'], 8080, "Should preserve port")
    print("  [PASS] test_register_aggregator_config_preserves_api_groups")

def test_process_accumulated_modifications_single():
    """Test process_accumulated_modifications with single modification."""
    mods = [
        {
            '_aggregator_api_groups': [
                {'group': 'servicemodel.ext.grafana.com', 'version': 'v1alpha1'}
            ],
            '_target': 'grafana',
        }
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    assert_true('services' in result, "Result should have services key")
    assert_true('aggregator-config' in result['services'], "Should create aggregator-config service")

    command = result['services']['aggregator-config']['command']
    assert_equals(len(command), 2, "Command should have 2 elements")
    assert_equals(command[0], '-c', "First element should be -c")

    script = command[1]
    assert_contains(script, 'servicemodel.ext.grafana.com', "Should contain group")
    assert_contains(script, 'v1alpha1', "Should contain version")
    print("  [PASS] test_process_accumulated_modifications_single")

def test_process_accumulated_modifications_grafana_depends_on():
    """Test process_accumulated_modifications adds grafana depends_on aggregator-config."""
    mods = [
        {
            '_aggregator_api_groups': [
                {'group': 'test.ext.grafana.com', 'version': 'v1alpha1'}
            ],
            '_target': 'grafana',
        }
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    assert_true('grafana' in result['services'], "Should have grafana service")
    assert_true('depends_on' in result['services']['grafana'], "Grafana should have depends_on")
    assert_true('aggregator-config' in result['services']['grafana']['depends_on'],
                "Grafana should depend on aggregator-config")
    assert_equals(result['services']['grafana']['depends_on']['aggregator-config']['condition'],
                  'service_started', "Should use service_started condition")
    print("  [PASS] test_process_accumulated_modifications_grafana_depends_on")

def test_process_accumulated_modifications_multiple():
    """Test process_accumulated_modifications accumulates multiple api_groups."""
    mods = [
        {
            '_aggregator_api_groups': [
                {'group': 'servicemodel.ext.grafana.com', 'version': 'v1alpha1'}
            ],
            '_target': 'grafana',
        },
        {
            '_aggregator_api_groups': [
                {'group': 'gamma.ext.grafana.com', 'version': 'v1alpha1'}
            ],
            '_target': 'grafana',
        },
        {
            '_aggregator_api_groups': [
                {'group': 'slo.plugins.grafana.com', 'version': 'v1alpha1'}
            ],
            '_target': 'grafana',
        },
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    script = result['services']['aggregator-config']['command'][1]
    # All three groups should be in a single command
    assert_contains(script, 'servicemodel.ext.grafana.com', "Should contain first group")
    assert_contains(script, 'gamma.ext.grafana.com', "Should contain second group")
    assert_contains(script, 'slo.plugins.grafana.com', "Should contain third group")
    print("  [PASS] test_process_accumulated_modifications_multiple")

def test_process_accumulated_modifications_deduplicates():
    """Test process_accumulated_modifications deduplicates by group name."""
    mods = [
        {
            '_aggregator_api_groups': [
                {'group': 'test.ext.grafana.com', 'version': 'v1alpha1'}
            ],
            '_target': 'grafana',
        },
        {
            '_aggregator_api_groups': [
                {'group': 'test.ext.grafana.com', 'version': 'v1alpha1'}  # Duplicate
            ],
            '_target': 'grafana',
        },
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    script = result['services']['aggregator-config']['command'][1]
    # Count occurrences - should only appear once
    count = script.count('test.ext.grafana.com')
    assert_equals(count, 1, "Duplicate group should be deduplicated")
    print("  [PASS] test_process_accumulated_modifications_deduplicates")

def test_process_accumulated_modifications_default_host_port():
    """Test process_accumulated_modifications uses defaults for host and port."""
    mods = [
        {
            '_aggregator_api_groups': [
                {'group': 'test.ext.grafana.com', 'version': 'v1'}
            ],
            '_target': 'grafana',
