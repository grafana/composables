def test_process_accumulated_register_environment_last_writer_wins():
    """Test register_environment uses last-writer-wins for duplicate keys."""
    mods = [
        {'_grafana_environment': {'GF_LOG_LEVEL': 'info'}, '_target': 'grafana'},
        {'_grafana_environment': {'GF_LOG_LEVEL': 'debug'}, '_target': 'grafana'},
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    env = result['services']['grafana']['environment']
    assert_equals(env['GF_LOG_LEVEL'], 'debug', "Last writer should win")
    print("  [PASS] test_process_accumulated_register_environment_last_writer_wins")

def test_process_accumulated_register_environment_merges():
    """Test register_environment merges vars from multiple callers."""
    mods = [
        {'_grafana_environment': {'GF_LOG_LEVEL': 'debug'}, '_target': 'grafana'},
        {'_grafana_environment': {'NODE_ENV': 'development'}, '_target': 'grafana'},
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    env = result['services']['grafana']['environment']
    assert_true('GF_LOG_LEVEL' in env, "Should have GF_LOG_LEVEL from first caller")
    assert_true('NODE_ENV' in env, "Should have NODE_ENV from second caller")
    print("  [PASS] test_process_accumulated_register_environment_merges")

