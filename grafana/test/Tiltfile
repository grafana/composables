def test_process_accumulated_passthrough_env():
    """Test process_accumulated_modifications resolves passthrough env."""
    mods = [
        {
            '_grafana_passthrough_env': ['API_KEY', 'SECRET_KEY'],
            '_target': 'grafana',
        },
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    env = result['services']['grafana']['environment']
    assert_equals(env['API_KEY'], '$API_KEY', "Should set API_KEY to $API_KEY")
    assert_equals(env['SECRET_KEY'], '$SECRET_KEY', "Should set SECRET_KEY to $SECRET_KEY")
    print("  [PASS] test_process_accumulated_passthrough_env")

def test_process_accumulated_passthrough_env_deduplicates():
    """Test process_accumulated_modifications deduplicates passthrough env vars."""
    mods = [
        {'_grafana_passthrough_env': ['KEY_A', 'KEY_B'], '_target': 'grafana'},
        {'_grafana_passthrough_env': ['KEY_B', 'KEY_C'], '_target': 'grafana'},
    ]
    result = process_accumulated_modifications(mods, '/tmp')

    env = result['services']['grafana']['environment']
    assert_true('KEY_A' in env, "Should have KEY_A")
    assert_true('KEY_B' in env, "Should have KEY_B (deduplicated)")
    assert_true('KEY_C' in env, "Should have KEY_C")
    print("  [PASS] test_process_accumulated_passthrough_env_deduplicates")

def test_process_accumulated_passthrough_env_sorted():
    """Test process_accumulated_modifications sorts passthrough env vars."""
    mods = [
        {'_grafana_passthrough_env': ['ZEBRA', 'APPLE'], '_target': 'grafana'},
    ]
    result = process_accumulated_modifications(mods, '/tmp')

