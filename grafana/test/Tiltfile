        {'username': 'testuser', 'password': 'testpass'},
    ])
    assert_true('_grafana_user_specs' in result, "Result should have _grafana_user_specs marker")
    assert_true('_target' in result, "Result should have _target field")
    assert_equals(result['_target'], 'grafana', "Target should be grafana")
    assert_equals(len(result['_grafana_user_specs']), 1, "Should have 1 user spec")
    print("  [PASS] test_provision_users_returns_marker")

def test_provision_users_preserves_specs():
    """Test provision_users preserves all user spec fields."""
    result = provision_users(user_specs=[
        {
            'username': 'dev-user',
            'password': 'dev-pass',
            'role': 'Editor',
            'rbac_roles': ['fixed:dashboards:writer'],
            'email': 'dev@example.com',
            'name': 'Dev User',
        },
    ])
    spec = result['_grafana_user_specs'][0]
    assert_equals(spec['username'], 'dev-user', "Should preserve username")
    assert_equals(spec['password'], 'dev-pass', "Should preserve password")
    assert_equals(spec['role'], 'Editor', "Should preserve role")
    assert_equals(spec['rbac_roles'], ['fixed:dashboards:writer'], "Should preserve rbac_roles")
    assert_equals(spec['email'], 'dev@example.com', "Should preserve email")
    assert_equals(spec['name'], 'Dev User', "Should preserve name")
    print("  [PASS] test_provision_users_preserves_specs")

