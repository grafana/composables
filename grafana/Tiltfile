# Grafana Tilt Extension
# Provides Grafana for development.
#
# Exports:
#   cc_export()                - Returns plugin struct for compose_composer
#   get_wire_when()                - Conditional wiring rules
#   provision_plugins()            - Helper to mount plugin provisioning directories
#   register_aggregator_config()   - Configure API server aggregation for AppPlatform
#   register_plugin()              - Helper to register Grafana plugins
#   register_dashboards()          - Register dashboards from provisioning directory
#   configure_data_volume()        - Configure Grafana data volume persistence

load('ext://compose_composer', 'cc_import', 'cc_create', 'cc_generate_master_compose', 'cc_docker_compose', 'cc_parse_cli_plugins', 'cc_get_active_profiles')

def provision_plugins(plugin_paths=[]):
    """
    Helper function to mount plugin provisioning files into Grafana.

    Args:
        plugin_paths: List of directory paths containing plugin provisioning files.
                     Each path should contain YAML files for plugin configuration.
                     Note: Grafana reads files directly from /etc/grafana/provisioning/plugins/
                     without recursing into subdirectories, so only ONE path is supported.

    Returns:
        Dict with compose_overrides to mount the plugin directory

    Example:
        grafana.provision_plugins([
            '/path/to/irm/dev/provisioning_files',
        ])
    """
    if not plugin_paths:
        return {}

    # Grafana only reads provisioning files directly in /etc/grafana/provisioning/plugins/
    # It does not recurse into subdirectories, so we can only support one plugin path
    if len(plugin_paths) > 1:
        fail("provision_plugins() only supports ONE plugin_path. " +
             "Grafana does not read subdirectories in provisioning/plugins/. " +
             "Please combine all provisioning YAML files into a single directory.")

    # Mount the single directory directly to /etc/grafana/provisioning/plugins/
    return {
        'services': {
            'grafana': {
                'volumes': [
                    plugin_paths[0] + ':/etc/grafana/provisioning/plugins:ro',
                ],
            },
        },
    }

def _generate_provisioning_file(plugin_name, staging_dir):
    """
    Generate a basic provisioning file for a plugin.

    Args:
        plugin_name: Plugin ID (e.g., 'grafana-irm-app')
        staging_dir: Directory where provisioning files will be staged

    Returns:
        Absolute path to the generated provisioning file

    The generated file contains a minimal provisioning configuration:
        apiVersion: 1
        apps:
          - type: <plugin_name>
            disabled: false
    """
    provisioning_content = """apiVersion: 1
apps:
  - type: %s
    disabled: false
""" % plugin_name

    # Ensure staging directory exists
    local('mkdir -p "%s/provisioning"' % staging_dir, quiet=True)

    provisioning_path = '%s/provisioning/%s.yaml' % (staging_dir, plugin_name)
    local('cat > "%s" <<\'EOF\'\n%sEOF' % (provisioning_path, provisioning_content), quiet=True)

    return provisioning_path

def _should_register_plugin(plugin_spec, active_profiles):
    """
    Check if a plugin should be registered based on profiles.

    Args:
        plugin_spec: Plugin specification dict with optional 'profiles' field (list of strings)
        active_profiles: List of currently active profiles

    Returns:
        True if plugin should be registered, False otherwise

    Rules:
        - If plugin has no profiles: always register (backward compatible)
        - If plugin has profiles: only register if at least one matches active_profiles (OR logic)
        - If active_profiles is empty and plugin has profiles: do not register
    """
    plugin_profiles = plugin_spec.get('profiles', [])

    # No profiles specified = always register (backward compatible)
    if not plugin_profiles:
        return True

    # No active profiles = only register plugins without profiles
    if not active_profiles:
        return False

    # Check if any of the plugin's profiles are active (OR logic)
    for profile in plugin_profiles:
        if profile in active_profiles:
            return True

    return False

def register_plugin(plugin_specs):
    """
    Helper function to register Grafana plugins.

    This mounts plugin dist directories, provisioning files, and configures
    Grafana to load unsigned plugins.

    Args:
        plugin_specs: List of plugin specification dicts, each with:
            - name: str (required)
                Plugin ID (e.g., 'grafana-labels-app')

            - dist: str or dict (required)
                Either:
                  - String: Direct mount spec (e.g., 'plugin-dist:/var/lib/grafana/plugins/name')
                  - String: Absolute path to dist dir (e.g., '/path/to/dist')
                  - Dict: {'source': '...', 'target': '...', 'read_only': bool}

            - provisioning_file: str (optional)
                Absolute path to provisioning YAML file.
                If not provided, a basic provisioning file will be auto-generated.
                Mounted to: /etc/grafana/provisioning/plugins/{name}.yaml

            - depends_on: list[str] (optional)
                Service names to add to grafana's depends_on
                Example: ['plugin-frontend-build', 'plugin-backend-build']

            - feature_toggles: str (optional)
                Comma-separated feature toggles to enable
                Example: 'labelsV2Enabled,grafanaAPIServerWithExperimentalAPIs'

            - profiles: list[str] (optional)
                List of profile names. Plugin will only be registered if at least one
                profile matches the active profiles (CC_PROFILES env var or --profile= flags).
                If not specified, plugin is always registered (backward compatible).
                Example: ['irm-app', 'oncall-app']

    Returns:
        Dict with compose_overrides structure targeting grafana service

    Example - Docker Volume Mount (gops-labels pattern):
        grafana.register_plugin([{
            'name': 'grafana-labels-app',
            'dist': 'plugin-dist:/var/lib/grafana/plugins/grafana-labels-app',
            'provisioning_file': os.path.dirname(__file__) + '/local/provisioning.yaml',
            'depends_on': ['plugin-frontend-build', 'plugin-backend-build'],
            'feature_toggles': 'labelsV2Enabled,grafanaAPIServerEnsureKubectlAccess',
        }])

    Example - Host Path Mount (irm pattern):
        grafana.register_plugin([{
            'name': 'grafana-irm-app',
            'dist': os.path.dirname(__file__) + '/packages/@plugins/grafana-irm-app/dist',
        }])

    Example - Multiple Plugins:
        grafana.register_plugin([
            {'name': 'grafana-irm-app', 'dist': '/path/to/irm/dist'},
            {'name': 'grafana-oncall-app', 'dist': '/path/to/oncall/dist'},
        ])
    """
    if not plugin_specs:
        return {}

    if type(plugin_specs) != 'list':
        fail("plugin_specs must be a list of dicts, got: " + str(type(plugin_specs)))

    # Get active profiles from compose_composer
    # cc_get_active_profiles is loaded at module top, so it's always available
    active_profiles = cc_get_active_profiles()

    # Filter plugin specs by profile
    filtered_specs = []
    for spec in plugin_specs:
        if type(spec) != 'dict':
            fail("Each plugin spec must be a dict, got: " + str(type(spec)))

        if _should_register_plugin(spec, active_profiles):
            filtered_specs.append(spec)
        else:
            plugin_name = spec.get('name', '<unknown>')
            plugin_profiles = spec.get('profiles', [])
            print('[grafana.register_plugin] Skipping %s (profiles: %s, active: %s)' %
                  (plugin_name, ','.join(plugin_profiles), ','.join(active_profiles)))

    # If no plugins to register after filtering, return empty compose overrides
    if not filtered_specs:
        return {}

    # Use filtered specs for the rest of the function
    plugin_specs = filtered_specs

    # Accumulate modifications
    volumes = []
    depends_on = []
    unsigned_plugins = []
    feature_toggles = []

    for spec in plugin_specs:
        # Validate required fields (type already validated during filtering)
        if 'name' not in spec:
            fail("Plugin spec missing required 'name' field: " + str(spec))
        if 'dist' not in spec:
            fail("Plugin spec missing required 'dist' field for plugin: " + spec['name'])

        name = spec['name']
        dist = spec['dist']

        # Handle dist mounting
        if type(dist) == 'string' or type(dist) == 'str':
            # Check if it's already a complete mount spec (contains ':')
            if ':' in dist:
                # Direct mount spec like 'plugin-dist:/var/lib/grafana/plugins/name'
                volume_mount = dist
                if not volume_mount.endswith(':ro'):
                    volume_mount = volume_mount + ':ro'
            else:
                # Absolute path - construct mount
                volume_mount = dist + ':/var/lib/grafana/plugins/' + name + ':ro'
        elif type(dist) == 'dict':
            # Dict format: {'source': '...', 'target': '...', 'read_only': True}
            source = dist.get('source', '')
            target = dist.get('target', '/var/lib/grafana/plugins/' + name)
            read_only = dist.get('read_only', True)
            volume_mount = source + ':' + target
            if read_only:
                volume_mount = volume_mount + ':ro'
        else:
            fail("dist must be string or dict, got: " + str(type(dist)) + " for plugin: " + name)

        volumes.append(volume_mount)

        # Handle provisioning file (auto-generate if not provided)
        if 'provisioning_file' in spec:
            prov_file = spec['provisioning_file']
        else:
            # Auto-generate provisioning file
            staging_dir = os.getenv('CC_STAGING_DIR', os.getcwd() + '/.cc')
            prov_file = _generate_provisioning_file(name, staging_dir)

        prov_mount = prov_file + ':/etc/grafana/provisioning/plugins/' + name + '.yaml:ro'
        volumes.append(prov_mount)

        # Collect depends_on (optional)
        if 'depends_on' in spec:
            spec_depends = spec['depends_on']
            if type(spec_depends) == 'list':
                for dep in spec_depends:
                    if dep not in depends_on:
                        depends_on.append(dep)
            else:
                fail("depends_on must be a list, got: " + str(type(spec_depends)) + " for plugin: " + name)

        # Collect unsigned plugin name
        unsigned_plugins.append(name)

        # Collect feature toggles (optional)
        if 'feature_toggles' in spec:
            toggles = spec['feature_toggles']
            if toggles:
                feature_toggles.append(toggles)

    # Build compose_overrides structure
    # Apply same volumes to both grafana and grafana-debug for inspection
    result = {
        'services': {
            'grafana': {
                'volumes': volumes,
                'environment': {
                    # Will be concatenated with existing via deep merge
                    'GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS': ','.join(unsigned_plugins),
                },
            },
            'grafana-debug': {
                'volumes': volumes,
            },
        },
    }

    # Add depends_on if specified (convert list to dict format for proper merging)
    if depends_on:
        depends_on_dict = {}
        for dep in depends_on:
            depends_on_dict[dep] = {'condition': 'service_healthy'}
        result['services']['grafana']['depends_on'] = depends_on_dict

    # Add feature toggles if specified
    if feature_toggles:
        # Concatenate all feature toggles with commas
        result['services']['grafana']['environment']['GF_FEATURE_TOGGLES_ENABLE'] = ','.join(feature_toggles)

    return result

def register_aggregator_config(api_groups):
    """
    Configure API server aggregation for Grafana AppPlatform.

    This helper enables Grafana to aggregate external Kubernetes API servers
    by creating a configuration file that lists the API groups to expose.

    Args:
        api_groups: List of dicts, each with:
            - group: str     - API group (e.g., 'servicemodel.ext.grafana.com')
            - version: str   - API version (e.g., 'v1alpha1')
            - host: str      - API server hostname (default: 'k3s-apiserver')
            - port: int      - API server port (default: 6443)

    Returns:
        Dict with compose_overrides structure to customize the aggregator-config service

    Example:
        grafana = cc_import(
            name='grafana',
            url='...',
        )

        def cc_export():
            return cc_create(
                'my-app',
                os.path.dirname(__file__) + '/docker-compose.yaml',
                grafana,
                modifications=[
                    grafana.register_aggregator_config(api_groups=[
                        {
                            'group': 'servicemodel.ext.grafana.com',
                            'version': 'v1alpha1',
                            'host': 'k3s-apiserver',
                            'port': 6443,
                        },
                    ]),
                ],
            )
    """
    if type(api_groups) != 'list':
        fail("api_groups must be a list, got: " + str(type(api_groups)))

    if not api_groups:
        fail("api_groups cannot be empty - provide at least one API group")

    # Build YAML content from api_groups
    yaml_lines = []
    for group_spec in api_groups:
        if type(group_spec) != 'dict':
            fail("Each api_group must be a dict, got: " + str(type(group_spec)))

        if 'group' not in group_spec or 'version' not in group_spec:
            fail("Each api_group must have 'group' and 'version' fields")

        # Set defaults
        host = group_spec.get('host', 'k3s-apiserver')
        port = group_spec.get('port', 6443)

        yaml_lines.append("- group: " + group_spec['group'])
        yaml_lines.append("  version: " + group_spec['version'])
        yaml_lines.append("  host: " + host)
        yaml_lines.append("  port: " + str(port))

    yaml_content = "\n".join(yaml_lines)

    # Return compose_overrides to create/customize the aggregator-config service
    return {
        'services': {
            'aggregator-config': {
                'image': 'alpine:latest',
                'entrypoint': ['/bin/sh'],
                'command': [
                    '-c',
                    '''
echo 'Creating aggregator config...'
cat << 'EOF' > /certs/aggregator-config.yaml
%s
EOF
echo 'Aggregator config created successfully'
cat /certs/aggregator-config.yaml
                    ''' % yaml_content,
                ],
                'depends_on': ['k3s-apiserver'],
                'volumes': ['k3s-certs:/certs'],
                'restart': 'no',
            },
        },
    }

def configure_data_volume(enabled=True):
    """
    Configure Grafana's data volume persistence mode.

    By default, Grafana uses persistent storage (grafana-data volume).
    This helper allows you to switch to ephemeral tmpfs storage for testing.

    Args:
        enabled: bool (default: True)
            Whether to use persistent storage. If False, uses tmpfs for
            ephemeral in-memory storage (data lost on container restart).

    Returns:
        Dict with compose_overrides structure

    Examples:
        # Disable persistence for ephemeral testing (fresh state each restart)
        grafana.configure_data_volume(enabled=False)

        # Combine with other helpers
        modifications=[
            grafana.register_plugin([{'name': 'my-plugin', 'dist': '...'}]),
            grafana.configure_data_volume(enabled=False),  # Fresh state each restart
        ]

    Note:
        Persistent storage is enabled by default in the base grafana.yaml.
        This helper only needs to be called when you want ephemeral (tmpfs) storage.
        The volume name is fixed as 'grafana-data' and cannot be customized due to
        Docker Compose limitations with mounting multiple volumes to the same path.
    """
    if not enabled:
        # Use tmpfs for ephemeral in-memory storage
        # tmpfs overrides the default volume mount from grafana.yaml
        return {
            'services': {
                'grafana': {
                    'tmpfs': ['/var/lib/grafana'],
                },
                'grafana-debug': {
                    'tmpfs': ['/var/lib/grafana'],
                },
            },
        }

    # Enabled - return empty dict (default volume from grafana.yaml is used)
    return {}

def register_dashboards(dashboards_path):
    """
    Register dashboards from a provisioning directory.

    This helper mounts a dashboard provisioning directory containing:
    - Dashboard provider YAML files (e.g., dashboards.yml)
    - Dashboard JSON files organized in subdirectories

    The entire directory is mounted to /etc/grafana/provisioning/dashboards/,
    allowing Grafana to discover all dashboard providers and their dashboard files.

    Args:
        dashboards_path: str (required)
            Absolute path to the dashboards provisioning directory.
            Should contain:
            - Provider YAML files that define dashboard sources
            - Subdirectories with dashboard JSON files

    Returns:
        Dict with compose_overrides structure

    Examples:
        # Mount dashboards directory
        grafana.register_dashboards(os.path.dirname(__file__) + '/provisioning/dashboards')

        # Combine with other helpers
        modifications=[
            grafana.register_plugin([{'name': 'my-plugin', 'dist': '...'}]),
            grafana.register_dashboards(APP_DIR + '/provisioning/dashboards'),
            grafana.configure_data_volume(enabled=True),
        ]

    Directory Structure Example:
        provisioning/dashboards/
        ├── dashboards.yml                  # Provider configuration
        ├── sample.yaml                     # Additional provider
        ├── dashboards-agent-management/    # Dashboard JSON files
        │   └── agent-overview.json
        ├── dashboards-alloy/               # Dashboard JSON files
        │   └── alloy-metrics.json
        └── dashboards-kubernetes/          # Dashboard JSON files
            └── k8s-cluster.json

    Provider YAML Format:
        apiVersion: 1
        providers:
        - name: dashboards-agent-management
          folder: "Agent Management"
          options:
            path: /etc/grafana/provisioning/dashboards/dashboards-agent-management
          type: file
    """
    # Input validation
    if not dashboards_path:
        fail("dashboards_path cannot be empty")

    if not dashboards_path.startswith('/'):
        fail("dashboards_path must be an absolute path, got: " + dashboards_path)

    return {
        'services': {
            'grafana': {
                'volumes': [
                    dashboards_path + ':/etc/grafana/provisioning/dashboards',
                ],
            },
            'grafana-debug': {
                'volumes': [
                    dashboards_path + ':/etc/grafana/provisioning/dashboards:ro',
                ],
            },
        },
    }

def cc_export():
    """Returns the plugin struct for compose_composer."""
    return cc_create(
        'grafana',
        os.path.dirname(__file__) + '/grafana.yaml',
        labels=['app'],
    )

# Declarative Wiring - Replaces callback-based approach

def get_wire_when():
    """
    Declare conditional wiring rules.
    
    When a trigger dependency is loaded, the specified modifications
    are applied to services in this extension's compose file.
    
    This is symmetric - the same wiring happens regardless of which
    plugin is the orchestrator.
    """
    print('wire when called')
    return {
        # When mysql is loaded, wire grafana to use it as database
        'mysql': {
            # Declare database requirement - picked up by mysql's process_accumulated_modifications()
            '_database_requirement': 'grafana',
            'services': {
                'grafana': {
                    # Add service dependency
                    'depends_on': ['db'],
                    
                    # Configure database connection
                    'environment': {
                        'GF_DATABASE_TYPE': 'mysql',
                        'GF_DATABASE_HOST': 'db:3306',
                        'GF_DATABASE_NAME': 'grafana',
                        'GF_DATABASE_USER': 'user',
                        'GF_DATABASE_PASSWORD': 'pass',
                        'GF_SESSION_PROVIDER': 'mysql',
                        'GF_SESSION_PROVIDER_CONFIG': 'user:pass@tcp(db:3306)/grafana',
                    },
                },
            },
        },
        
        # When k3s-apiserver is loaded, wire grafana to use it
        'k3s-apiserver': {
            'services': {
                'grafana': {
                    # Add service dependency
                    'depends_on': ['k3s-apiserver'],

                    # Mount the shared certificates volume
                    'volumes': [
                        'k3s-certs:/etc/kubernetes/pki:ro',
                    ],

                    # Set environment variables
                    'environment': {
                        'KUBECONFIG': '/etc/grafana/kubeconfig.yaml',
                        'GF_GRAFANA_APISERVER_PROXY_CLIENT_CERT_FILE': '/etc/kubernetes/pki/api-server-aggregation/apiserver-client.pem',
                        'GF_GRAFANA_APISERVER_PROXY_CLIENT_KEY_FILE': '/etc/kubernetes/pki/api-server-aggregation/apiserver-client-key.pem',
                        'GF_GRAFANA_APISERVER_REMOTE_SERVICES_FILE': '/etc/kubernetes/pki/aggregator-config.yaml',
                    },
                },
                # Add aggregator-config service when k3s is present
                'aggregator-config': {
                    'image': 'alpine:latest',
                    'volumes': [
                        'k3s-certs:/certs',
                    ],
                    'depends_on': ['k3s-apiserver'],
                    'entrypoint': ['/bin/sh'],
                    'command': [
                        '-c',
                        '''echo 'Creating default aggregator config...'
cat << EOF > /certs/aggregator-config.yaml
# Default empty config - use register_aggregator_config() to customize
[]
EOF
echo 'Aggregator config created successfully'
cat /certs/aggregator-config.yaml''',
                    ],
                    'restart': 'no',
                },
            },
        },

        # When NATS is loaded, wire grafana to use it for real-time events
        'nats': {
            'services': {
                'grafana': {
                    'depends_on': ['nats'],
                    'environment': {
                        'DASH_PKG_NATS_SERVER_ADDRESS': 'nats://nats:4222',
                    },
                },
            },
        },

        # When renderer is loaded, configure grafana to use it
        'renderer': {
            'services': {
                'grafana': {
                    'depends_on': ['renderer'],
                    'environment': {
                        'GF_RENDERING_SERVER_URL': 'http://renderer:8081/render',
                        'GF_RENDERING_CALLBACK_URL': 'http://grafana:3000/',
                    },
                },
            },
        },

        # When jaeger is loaded, configure grafana for tracing
        'jaeger': {
            'services': {
                'grafana': {
                    'depends_on': ['jaeger'],
                    'environment': {
                        'OTEL_EXPORTER_OTLP_ENDPOINT': 'http://jaeger:4317',
                        'OTEL_TRACES_SAMPLER': 'always_on',
                    },
                },
            },
        },
    }

