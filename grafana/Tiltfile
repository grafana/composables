# Grafana Tilt Extension
# Provides Grafana for development.
#
# Exports:
#   cc_get_plugin()     - Returns plugin struct for compose_composer
#   get_wire_when()     - Conditional wiring rules
#   provision_plugins() - Helper to mount plugin provisioning directories

load('ext://compose_composer', 'cc_composable', 'cc_local_composable', 'cc_generate_master_compose', 'cc_docker_compose', 'cc_parse_cli_plugins')

def provision_plugins(plugin_paths=[]):
    """
    Helper function to mount plugin provisioning files into Grafana.

    Args:
        plugin_paths: List of directory paths containing plugin provisioning files
                     Each path should contain YAML files for plugin configuration

    Returns:
        Dict with compose_overrides to mount the plugin directories

    Example:
        grafana.provision_plugins([
            '/path/to/irm/dev/provisioning_files/oncall',
            '/path/to/irm/dev/provisioning_files/incident',
        ])
    """
    if not plugin_paths:
        return {}

    # Build volume mounts for each plugin path
    volumes = []
    for i, path in enumerate(plugin_paths):
        # Mount each directory to a unique location in grafana provisioning
        volumes.append(path + ':/etc/grafana/provisioning/plugins/plugin-' + str(i) + ':ro')

    return {
        'services': {
            'grafana': {
                'volumes': volumes,
            },
        },
    }

def cc_get_plugin():
    """Returns the plugin struct for compose_composer."""
    return cc_local_composable(
        'grafana',
        os.path.dirname(__file__) + '/grafana.yaml',
        labels=['app'],
    )

# Declarative Wiring - Replaces callback-based approach

def get_wire_when():
    """
    Declare conditional wiring rules.
    
    When a trigger dependency is loaded, the specified modifications
    are applied to services in this extension's compose file.
    
    This is symmetric - the same wiring happens regardless of which
    plugin is the orchestrator.
    """
    print('wire when called')
    return {
        # When mysql is loaded, wire grafana to use it as database
        'mysql': {
            'services': {
                'grafana': {
                    # Add service dependency
                    'depends_on': ['db'],
                    
                    # Configure database connection
                    'environment': {
                        'GF_DATABASE_TYPE': 'mysql',
                        'GF_DATABASE_HOST': 'db:3306',
                        'GF_DATABASE_NAME': 'grafana',
                        'GF_DATABASE_USER': 'user',
                        'GF_DATABASE_PASSWORD': 'pass',
                        'GF_SESSION_PROVIDER': 'mysql',
                        'GF_SESSION_PROVIDER_CONFIG': 'user:pass@tcp(db:3306)/grafana',
                    },
                },
            },
        },
        
        # When k3s-apiserver is loaded, wire grafana to use it
        'k3s-apiserver': {
            'services': {
                'grafana': {
                    # Add service dependency
                    'depends_on': ['k3s-apiserver'],

                    # Mount the shared certificates volume
                    'volumes': [
                        'k3s-certs:/etc/kubernetes/pki:ro',
                    ],

                    # Set environment variables
                    'environment': {
                        'KUBECONFIG': '/etc/grafana/kubeconfig.yaml',
                        'GF_GRAFANA_APISERVER_PROXY_CLIENT_CERT_FILE': '/etc/kubernetes/pki/api-server-aggregation/apiserver-client.pem',
                        'GF_GRAFANA_APISERVER_PROXY_CLIENT_KEY_FILE': '/etc/kubernetes/pki/api-server-aggregation/apiserver-client-key.pem',
                        # 'GF_GRAFANA_APISERVER_REMOTE_SERVICES_FILE': '/etc/kubernetes/pki/aggregator-config.yaml',

                    },
                },
            },
        },

        # When NATS is loaded, wire grafana to use it for real-time events
        'nats': {
            'services': {
                'grafana': {
                    'depends_on': ['nats'],
                    'environment': {
                        'DASH_PKG_NATS_SERVER_ADDRESS': 'nats://nats:4222',
                    },
                },
            },
        },

        # When renderer is loaded, configure grafana to use it
        'renderer': {
            'services': {
                'grafana': {
                    'depends_on': ['renderer'],
                    'environment': {
                        'GF_RENDERING_SERVER_URL': 'http://renderer:8081/render',
                        'GF_RENDERING_CALLBACK_URL': 'http://grafana:3000/',
                    },
                },
            },
        },

        # When jaeger is loaded, configure grafana for tracing
        'jaeger': {
            'services': {
                'grafana': {
                    'depends_on': ['jaeger'],
                    'environment': {
                        'OTEL_EXPORTER_OTLP_ENDPOINT': 'http://jaeger:4317',
                        'OTEL_TRACES_SAMPLER': 'always_on',
                    },
                },
            },
        },
    }

