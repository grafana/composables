# PostgreSQL Test Tilt Extension
# Provides PostgreSQL test database for SQL testing.
#
# Exports:
#   cc_export()    - Returns plugin struct for compose_composer

load('ext://compose_composer', 'cc_init')

cc = cc_init('postgres-test')

def cc_export():
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'postgres-test',
        os.path.dirname(__file__) + '/postgres-test.yaml',
        labels=['sql-test'],
    )
