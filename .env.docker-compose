# Docker Compose Environment Variables
# Port mappings to avoid conflicts with K8s services during migration
# After K8s is removed, these will be restored to standard ports

# ============================================================================
# Application Services
# ============================================================================

# Grafana
GRAFANA_PORT=13000

# OnCall Backend
ONCALL_API_PORT=18083

# Incident Backend
INCIDENT_API_PORT=18888

# ============================================================================
# Infrastructure Services
# ============================================================================

# MySQL
MYSQL_PORT=13306

# Redis
REDIS_PORT=16379

# RabbitMQ
RABBITMQ_PORT=15673# AMQP protocol (avoids K8s 5672)
RABBITMQ_MGMT_PORT=25672   # Management UI (avoids K8s 15672)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# NATS
NATS_CLIENT_PORT=14222     # Client connections
NATS_HTTP_PORT=18222# HTTP monitoring
NATS_ROUTING_PORT=16222    # Routing port for clustering

# ============================================================================
# Optional Services (activated by profiles)
# ============================================================================

# Tempo (tracing)
TEMPO_HTTP_PORT=13200
TEMPO_OTLP_PORT=14317

# Azurite (Azure Storage emulator)
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

# Prometheus (metrics)
PROMETHEUS_PORT=19090

# Loki (logs)
LOKI_HTTP_PORT=13100

# Jaeger (tracing)
JAEGER_UDP_PORT=16831
JAEGER_OTLP_PORT=14318
JAEGER_PROMETHEUS_PORT=15778
JAEGER_UI_PORT=16686

# Renderer (image rendering)
RENDERER_PORT=18081

# K3s API Server
K3S_API_SERVER_PORT=16443
TRAEFIK_PORT=19443
TRAEFIK_DASHBOARD_PORT=18089

# ClickHouse (analytics database)
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000

# BigQuery Emulator
BIGQUERY_EMULATOR_PORT=19050

# ============================================================================
# Test Database Ports
# ============================================================================

# MySQL Test (separate instance for testing)
MYSQL_TEST_PORT=13307

# PostgreSQL Test
POSTGRES_TEST_PORT=15433

# MSSQL Test
MSSQL_TEST_PORT=11433

# ============================================================================
# Debug Settings
# ============================================================================

# OnCall debug port (debugpy)
ONCALL_DEBUG_PORT=15678

# Incident debug port (delve)
INCIDENT_DEBUG_PORT=12345
