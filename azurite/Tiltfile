# Azurite Tilt Extension
# Provides Azure Storage emulator for development (optional).
#
# Exports:
#   cc_export(cc)  - Returns plugin struct for compose_composer

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'azurite',
        os.path.dirname(__file__) + '/azurite.yaml',
        labels=['infra', 'storage'],
    )
