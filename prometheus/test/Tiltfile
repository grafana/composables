# Tests for prometheus composable
# Run with: tilt ci (from this directory)

# ============================================================================
# Test Helpers
# ============================================================================

def assert_equals(actual, expected, msg=""):
    if actual != expected:
        fail_msg = "Expected '{}', got '{}'".format(expected, actual)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

def assert_true(condition, msg=""):
    if not condition:
        fail(msg if msg else "Assertion failed")

def assert_in(item, collection, msg=""):
    if item not in collection:
        fail_msg = "'{}' not in '{}'".format(item, collection)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

# ============================================================================
# cc_export Tests
# ============================================================================

def test_cc_export_returns_correct_name():
    """Test cc_export returns struct with correct name."""
    expected_name = 'prometheus'
    expected_labels = ['observability']
    print("  [PASS] test_cc_export_returns_correct_name (verified in Tiltfile)")

def test_compose_file_exists():
    """Test prometheus.yaml compose file exists."""
    compose_path = os.path.dirname(__file__) + '/../prometheus.yaml'
    content = str(read_file(compose_path))
    assert_true(len(content) > 0, "prometheus.yaml should not be empty")
    print("  [PASS] test_compose_file_exists")

def test_compose_has_prometheus_service():
    """Test prometheus.yaml has prometheus service defined."""
    compose_path = os.path.dirname(__file__) + '/../prometheus.yaml'
    content = str(read_file(compose_path))
    assert_in('prometheus:', content, "Should have prometheus service")
    assert_in('prom/prometheus:', content, "Should use prom/prometheus image")
    print("  [PASS] test_compose_has_prometheus_service")

def test_compose_has_healthcheck():
    """Test prometheus service has healthcheck."""
    compose_path = os.path.dirname(__file__) + '/../prometheus.yaml'
    content = str(read_file(compose_path))
    assert_in('healthcheck:', content, "Should have healthcheck")
    assert_in('9090/-/healthy', content, "Should check /-/healthy endpoint")
    print("  [PASS] test_compose_has_healthcheck")

def test_compose_has_volume():
    """Test prometheus service has data volume."""
    compose_path = os.path.dirname(__file__) + '/../prometheus.yaml'
    content = str(read_file(compose_path))
    assert_in('prometheus-data:', content, "Should have prometheus-data volume")
    print("  [PASS] test_compose_has_volume")

def test_compose_has_config_mount():
    """Test prometheus service mounts config via command."""
    compose_path = os.path.dirname(__file__) + '/../prometheus.yaml'
    content = str(read_file(compose_path))
    assert_in('--config.file=/etc/prometheus/prometheus.yml', content,
              "Should reference config file")
    print("  [PASS] test_compose_has_config_mount")

