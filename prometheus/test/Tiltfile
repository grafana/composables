def test_tiltfile_has_register_remote_write():
    """Test Tiltfile exports register_remote_write helper."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('def register_remote_write(', content, "Should define register_remote_write function")
    assert_in('_prometheus_remote_write', content, "Should use _prometheus_remote_write marker")
    print("  [PASS] test_tiltfile_has_register_remote_write")

def test_tiltfile_has_register_scrape_config():
    """Test Tiltfile exports register_scrape_config helper."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('def register_scrape_config(', content, "Should define register_scrape_config function")
    assert_in('_prometheus_scrape_config', content, "Should use _prometheus_scrape_config marker")
    print("  [PASS] test_tiltfile_has_register_scrape_config")

def test_tiltfile_has_process_accumulated_modifications():
    """Test Tiltfile exports process_accumulated_modifications callback."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('def process_accumulated_modifications(', content,
              "Should define process_accumulated_modifications function")
    assert_in('all_modifications', content, "Should accept all_modifications parameter")
    assert_in('orchestrator_dir', content, "Should accept orchestrator_dir parameter")
    print("  [PASS] test_tiltfile_has_process_accumulated_modifications")

def test_process_accumulated_handles_remote_write():
    """Test process_accumulated_modifications handles _prometheus_remote_write."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in("'_prometheus_remote_write' in mod", content,
              "Should check for _prometheus_remote_write marker")
    assert_in('remote_write:', content, "Should generate remote_write config section")
    print("  [PASS] test_process_accumulated_handles_remote_write")

def test_process_accumulated_handles_scrape_config():
    """Test process_accumulated_modifications handles _prometheus_scrape_config."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in("'_prometheus_scrape_config' in mod", content,
              "Should check for _prometheus_scrape_config marker")
    assert_in('scrape_configs:', content, "Should generate scrape_configs section")
    print("  [PASS] test_process_accumulated_handles_scrape_config")

def test_process_accumulated_generates_prometheus_yml():
    """Test process_accumulated_modifications generates prometheus.yml file."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in("'/prometheus.yml'", content, "Should generate prometheus.yml")
    assert_in('.cc', content, "Should use staging directory")
    assert_in('/etc/prometheus/prometheus.yml:ro', content,
              "Should mount config as read-only")
    print("  [PASS] test_process_accumulated_generates_prometheus_yml")

def test_process_accumulated_adds_self_scrape():
    """Test process_accumulated_modifications includes prometheus self-scrape."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('localhost:9090', content, "Should include prometheus self-scrape target")
    assert_in("job_name: prometheus", content, "Should have prometheus job")
    print("  [PASS] test_process_accumulated_adds_self_scrape")

# ============================================================================
# Run All Tests
# ============================================================================

def run_tests():
    print("\n=== Prometheus Composable Unit Tests ===")
    test_cc_export_returns_correct_name()
    test_compose_file_exists()
    test_compose_has_prometheus_service()
    test_compose_has_healthcheck()
    test_compose_has_volume()
    test_compose_has_config_mount()
    test_tiltfile_has_cc_export()

    print("\n=== Wire-When Tests ===")
    test_tiltfile_has_get_wire_when()
    test_datasource_file_exists()
    test_datasource_has_correct_config()
    test_wire_when_grafana_has_datasource_mount()

    print("\n=== Helper Function Tests ===")
    test_tiltfile_has_register_remote_write()
    test_tiltfile_has_register_scrape_config()
    test_tiltfile_has_process_accumulated_modifications()
    test_process_accumulated_handles_remote_write()
    test_process_accumulated_handles_scrape_config()
    test_process_accumulated_generates_prometheus_yml()
    test_process_accumulated_adds_self_scrape()

    print("\n" + "=" * 50)
    print("All tests passed!")
    print("=" * 50)

# Run tests
run_tests()

# Dummy resource to satisfy tilt ci
local_resource('tests', cmd='echo "Tests completed"', auto_init=False)
