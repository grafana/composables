# MySQL Test Tilt Extension
# Provides MySQL test database for SQL testing (different port than main MySQL).
#
# Exports:
#   cc_export(cc)  - Returns plugin struct for compose_composer

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'mysql-test',
        os.path.dirname(__file__) + '/mysql-test.yaml',
        labels=['sql-test'],
    )
