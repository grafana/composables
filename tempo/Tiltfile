# Tempo Tilt Extension
# Provides Tempo distributed tracing backend for development (optional).
#
# Exports:
#   cc_export(cc)    - Returns plugin struct for compose_composer
#   cc_wire_when(cc) - Conditional wiring rules (auto-register datasource in Grafana)

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'tempo',
        os.path.dirname(__file__) + '/tempo.yaml',
        labels=['infra', 'observability'],
    )

def cc_wire_when(cc):
    """
    Declare conditional wiring rules.

    When Grafana is present, automatically register Tempo as a datasource.
    This follows the symmetric pattern - any project using both Tempo and Grafana
    gets the datasource configured automatically.
    """
    return {
        'grafana': {
            'services': {
                'grafana': {
                    'depends_on': ['tempo'],
                    'volumes': [
                        os.path.dirname(__file__) + '/tempo-datasource.yaml:/etc/grafana/provisioning/datasources/tempo.yaml:ro',
                    ],
                },
            },
        },
    }

