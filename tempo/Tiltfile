# Tempo Tilt Extension
# Provides Tempo distributed tracing backend for development (optional).
#
# Exports:
#   cc_export(cc)  - Returns plugin struct for compose_composer

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'tempo',
        os.path.dirname(__file__) + '/tempo.yaml',
        labels=['infra', 'observability'],
    )

