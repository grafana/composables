# NATS Tilt Extension
# Provides NATS message broker for event-driven architectures.
#
# Exports:
#   cc_export()    - Returns plugin struct for compose_composer

load('ext://compose_composer', 'cc_create', 'cc_generate_master_compose', 'cc_docker_compose', 'cc_parse_cli_plugins')

def cc_export():
    """Returns the plugin struct for compose_composer."""
    return cc_create(
        'nats',
        os.path.dirname(__file__) + '/nats.yaml',
        labels=['infra'],
    )

