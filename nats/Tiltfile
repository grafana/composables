# NATS Tilt Extension
# Provides NATS message broker for event-driven architectures.
#
# Exports:
#   cc_get_plugin()    - Returns plugin struct for compose_composer
#   get_compose_path() - Returns path to the compose file (legacy)
#   get_provides()     - What this extension provides (for documentation)

# Set up extension repo for standalone mode only
if __file__ == config.main_path:
    v1alpha1.extension_repo(
        name='local-tilt-extensions',
        url='file://' + os.path.dirname(__file__) + '/../..'
    )
    v1alpha1.extension(
        name='compose_composer',
        repo_name='local-tilt-extensions',
        repo_path='tilt-extensions/compose_composer'
    )

load('ext://compose_composer', 'cc_local_compose')

def cc_get_plugin():
    """Returns the plugin struct for compose_composer."""
    return cc_local_compose(
        'nats',
        os.path.dirname(__file__) + '/nats.yaml',
        labels=['infra'],
    )

def get_compose_path(file='nats.yaml'):
    """Returns the absolute path to the compose file for this component."""
    return os.path.dirname(__file__) + '/' + file

def get_provides():
    """
    Declare what this extension provides.
    Used for documentation and discoverability.
    """
    return {
        'services': [
            {
                'name': 'nats',
                'description': 'NATS message broker',
                'ports': {
                    '4222': 'Client connections',
                    '8222': 'HTTP monitoring',
                    '6222': 'Routing port for clustering',
                },
            },
        ],
    }

# ============================================================================
# Standalone Mode
# ============================================================================

# If loaded directly via 'tilt up', run the compose file
if __file__ == config.main_path:
    docker_compose(get_compose_path())
