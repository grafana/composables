# Mimir Tilt Extension
# Provides Prometheus-compatible metrics storage.
#
# Exports:
#   cc_export(cc)     - Returns plugin struct for compose_composer
#   cc_wire_when(cc) - Conditional wiring rules (auto-register datasource in Grafana)

def cc_export(cc):
    """Returns the plugin struct for compose_composer."""
    return cc.create(
        'mimir',
        os.path.dirname(__file__) + '/mimir.yaml',
        labels=['observability'],
    )

def cc_wire_when(cc):
    """
    Declare conditional wiring rules.

    - When Grafana is present, automatically register Mimir as a datasource.
    - When Prometheus is present, configure remote_write to send metrics to Mimir.

    This follows the symmetric pattern - any project using Mimir with Grafana/Prometheus
    gets the integrations configured automatically.
    """
    return {
        'grafana': {
            'services': {
                'grafana': {
                    'depends_on': ['mimir'],
                    'volumes': [
                        os.path.dirname(__file__) + '/mimir-datasource.yaml:/etc/grafana/provisioning/datasources/mimir.yaml:ro',
                    ],
                },
            },
        },
        'prometheus': {
            # This marker will be processed by prometheus.process_accumulated_modifications()
            '_prometheus_remote_write': [
                {'url': 'http://mimir:9009/api/v1/push', 'name': 'mimir'},
            ],
        },
    }
