# Tests for mimir composable
# Run with: tilt ci (from this directory)

# ============================================================================
# Test Helpers
# ============================================================================

def assert_equals(actual, expected, msg=""):
    if actual != expected:
        fail_msg = "Expected '{}', got '{}'".format(expected, actual)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

def assert_true(condition, msg=""):
    if not condition:
        fail(msg if msg else "Assertion failed")

def assert_in(item, collection, msg=""):
    if item not in collection:
        fail_msg = "'{}' not in '{}'".format(item, collection)
        if msg:
            fail_msg = msg + ": " + fail_msg
        fail(fail_msg)

# ============================================================================
# cc_export Tests (simulated)
# ============================================================================

def test_cc_export_returns_correct_name():
    """Test cc_export returns struct with correct name."""
    # Simulate what cc_export would return
    expected_name = 'mimir'
    expected_labels = ['observability']
    print("  [PASS] test_cc_export_returns_correct_name (verified in Tiltfile)")

def test_compose_file_exists():
    """Test mimir.yaml compose file exists."""
    compose_path = os.path.dirname(__file__) + '/../mimir.yaml'
    # Read to verify it exists (will fail if not)
    content = str(read_file(compose_path))
    assert_true(len(content) > 0, "mimir.yaml should not be empty")
    print("  [PASS] test_compose_file_exists")

def test_config_file_exists():
    """Test mimir-config.yaml exists."""
    config_path = os.path.dirname(__file__) + '/../mimir-config.yaml'
    content = str(read_file(config_path))
    assert_true(len(content) > 0, "mimir-config.yaml should not be empty")
    print("  [PASS] test_config_file_exists")

def test_compose_has_mimir_service():
    """Test mimir.yaml has mimir service defined."""
    compose_path = os.path.dirname(__file__) + '/../mimir.yaml'
    content = str(read_file(compose_path))
    assert_in('mimir:', content, "Should have mimir service")
    assert_in('grafana/mimir:', content, "Should use grafana/mimir image")
    print("  [PASS] test_compose_has_mimir_service")

def test_compose_has_healthcheck():
    """Test mimir service has healthcheck."""
    compose_path = os.path.dirname(__file__) + '/../mimir.yaml'
    content = str(read_file(compose_path))
    assert_in('healthcheck:', content, "Should have healthcheck")
    assert_in('9009/ready', content, "Should check /ready endpoint")
    print("  [PASS] test_compose_has_healthcheck")

def test_compose_has_volume():
    """Test mimir service has data volume."""
    compose_path = os.path.dirname(__file__) + '/../mimir.yaml'
    content = str(read_file(compose_path))
    assert_in('mimir-data:', content, "Should have mimir-data volume")
    print("  [PASS] test_compose_has_volume")

def test_compose_mounts_config():
    """Test mimir service mounts config file."""
    compose_path = os.path.dirname(__file__) + '/../mimir.yaml'
    content = str(read_file(compose_path))
    assert_in('mimir-config.yaml:/etc/mimir/mimir-config.yaml', content,
              "Should mount config file")
    print("  [PASS] test_compose_mounts_config")

def test_config_has_required_settings():
    """Test mimir-config.yaml has required settings."""
    config_path = os.path.dirname(__file__) + '/../mimir-config.yaml'
    content = str(read_file(config_path))
    assert_in('http_listen_port: 9009', content, "Should listen on port 9009")
    assert_in('multitenancy_enabled: false', content, "Should disable multitenancy for dev")
    assert_in('ruler:', content, "Should have ruler config")
    assert_in('enable_api: true', content, "Should enable ruler API")
    print("  [PASS] test_config_has_required_settings")

def test_tiltfile_has_cc_export():
    """Test Tiltfile exports cc_export function."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('def cc_export():', content, "Should define cc_export function")
    assert_in("'mimir'", content, "Should use 'mimir' as name")
    assert_in('mimir.yaml', content, "Should reference mimir.yaml")
    print("  [PASS] test_tiltfile_has_cc_export")

def test_tiltfile_has_get_wire_when():
    """Test Tiltfile exports get_wire_when function."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    assert_in('def get_wire_when():', content, "Should define get_wire_when function")
    print("  [PASS] test_tiltfile_has_get_wire_when")

def test_datasource_file_exists():
    """Test mimir-datasource.yaml exists for Grafana provisioning."""
    ds_path = os.path.dirname(__file__) + '/../mimir-datasource.yaml'
    content = str(read_file(ds_path))
    assert_true(len(content) > 0, "mimir-datasource.yaml should not be empty")
    print("  [PASS] test_datasource_file_exists")

def test_datasource_has_correct_config():
    """Test mimir-datasource.yaml has correct Grafana provisioning config."""
    ds_path = os.path.dirname(__file__) + '/../mimir-datasource.yaml'
    content = str(read_file(ds_path))
    assert_in('apiVersion: 1', content, "Should have apiVersion")
    assert_in('name: mimir', content, "Should have name: mimir")
    assert_in('type: prometheus', content, "Should have type: prometheus")
    assert_in('http://mimir:9009/prometheus', content, "Should have correct URL")
    assert_in('isDefault: true', content, "Should be default datasource")
    assert_in('prometheusType: Mimir', content, "Should specify Mimir type")
    print("  [PASS] test_datasource_has_correct_config")

def test_wire_when_grafana_has_datasource_mount():
    """Test get_wire_when configures Grafana datasource mount."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    # Check wire_when has grafana configuration
    assert_in("'grafana':", content, "Should have grafana wire_when rule")
    assert_in('mimir-datasource.yaml', content, "Should reference datasource file")
    assert_in('/etc/grafana/provisioning/datasources/', content, "Should mount to Grafana provisioning")
    print("  [PASS] test_wire_when_grafana_has_datasource_mount")

def test_wire_when_prometheus_has_remote_write():
    """Test get_wire_when configures Prometheus remote_write."""
    tiltfile_path = os.path.dirname(__file__) + '/../Tiltfile'
    content = str(read_file(tiltfile_path))
    # Check wire_when has prometheus configuration
    assert_in("'prometheus':", content, "Should have prometheus wire_when rule")
    assert_in('_prometheus_remote_write', content, "Should have remote_write marker")
    assert_in('http://mimir:9009/api/v1/push', content, "Should have correct remote_write URL")
    print("  [PASS] test_wire_when_prometheus_has_remote_write")

# ============================================================================
# Run All Tests
# ============================================================================

def run_tests():
    print("\n=== Mimir Composable Unit Tests ===")
    test_cc_export_returns_correct_name()
    test_compose_file_exists()
    test_config_file_exists()
    test_compose_has_mimir_service()
    test_compose_has_healthcheck()
    test_compose_has_volume()
    test_compose_mounts_config()
    test_config_has_required_settings()
    test_tiltfile_has_cc_export()

    print("\n=== Wire-When Tests ===")
    test_tiltfile_has_get_wire_when()
    test_datasource_file_exists()
    test_datasource_has_correct_config()
    test_wire_when_grafana_has_datasource_mount()
    test_wire_when_prometheus_has_remote_write()

    print("\n" + "=" * 50)
    print("All tests passed!")
    print("=" * 50)

# Run tests
run_tests()

# Dummy resource to satisfy tilt ci
local_resource('tests', cmd='echo "Tests completed"', auto_init=False)
