# Integration test for mimir composable
# Run with: tilt ci -f Tiltfile.integration (from this directory)
#
# This test verifies mimir works correctly when loaded via compose_composer.

COMPOSABLES_URL = os.getenv('COMPOSABLES_URL', 'file://' + os.path.abspath(os.path.dirname(__file__) + '/../..'))
COMPOSE_COMPOSER_URL = os.getenv('COMPOSE_COMPOSER_URL', 'https://github.com/grafana/tilt-extensions')
COMPOSE_COMPOSER_REF = os.getenv('COMPOSE_COMPOSER_REF', 'compose-composer')

# Set up extension repo for standalone mode only
if __file__ == config.main_path:
    v1alpha1.extension_repo(name='grafana-tilt-extensions', url=COMPOSE_COMPOSER_URL, ref=COMPOSE_COMPOSER_REF)
    v1alpha1.extension(name='compose_composer', repo_name='grafana-tilt-extensions', repo_path='compose_composer')

load('ext://compose_composer', 'cc_init')

allow_k8s_contexts(k8s_context())

cc = cc_init('mimir-test', composables_url=COMPOSABLES_URL)

# Import mimir as a dependency
mimir = cc.use('mimir', labels=['observability'])

def cc_export():
    """Test orchestrator that uses mimir composable."""
    return cc.create(
        'mimir-test',
        os.path.dirname(__file__) + '/docker-compose.yaml',
        mimir,
        labels=['test']
    )

# ============================================================================
# Standalone Mode
# ============================================================================

if __file__ == config.main_path:
    # Generate master compose - this handles all the compose_composer logic
    master = cc.generate_master_compose(
        cc_export(),
        cc.parse_cli_plugins(os.path.dirname(__file__)),
    )
    cc.docker_compose(master, wait=True)

    # Add health check resource
    local_resource(
        'mimir-health-check',
        cmd='curl -sf http://localhost:9009/ready || exit 1',
        resource_deps=['mimir'],
        labels=['test'],
    )
